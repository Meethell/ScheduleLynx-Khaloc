<Window
    x:Class="Client.Views.NewIssueWindowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="MessageBoxWindow"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="1"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  Đảm bảo Background không phải là Transparent  -->
    <Window.Resources>
        <Style TargetType="{x:Type Window}">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome
                        CaptionHeight="0"
                        CornerRadius="10"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Width="600" Height="auto">
        <GroupBox Header="Card Group Box" Style="{StaticResource MaterialDesignCardGroupBox}">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Kind="ReportProblem" />
                        <TextBlock
                            x:Name="TitleTextBox"
                            Margin="5"
                            FontWeight="Bold"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="TẠO MỚI ISSUE" />
                    </StackPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                <!--  Title tb  -->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="ListBox" />
                    <TextBlock
                        Margin="5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="TIÊU ĐỀ" />
                </StackPanel>
                <TextBox
                    Width="{Binding ActualWidth, ElementName=MainStackPanel}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding Issue.Title}"
                    TextWrapping="Wrap" />
                <!--  INSTRUMENT DETAILS  -->
                <TextBlock
                    Margin="0,5"
                    FontWeight="Medium"
                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                    Text="CHI TIẾT" />
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <!--  Instrument Type  -->
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Sort" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="Loại thiết bị: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Issue.Model.ModelType.Type}" />
                </StackPanel>
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <!--  Instrument Manufacturer  -->
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Factory" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="Nhà sản xuất: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Issue.Model.Manufacturer.Name}" />
                    <!--  Model  -->
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="30,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Devices" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="Model: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Issue.Model.Name}" />
                </StackPanel>
                <Separator Margin="0,5" />
                <!--  Description tb  -->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Text" />
                    <TextBlock
                        Margin="5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="MÔ TẢ LỖI" />
                </StackPanel>
                <TextBox
                    Height="100"
                    MaxHeight="300"
                    Margin="0,5"
                    HorizontalAlignment="Stretch"
                    AcceptsReturn="True"
                    FontSize="12"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Issue.IssueDescription}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <!--  Nguyên nhân  -->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Error" />
                    <TextBlock
                        Margin="5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="NGUYÊN NHÂN" />
                </StackPanel>
                <TextBox
                    Height="100"
                    MaxHeight="300"
                    Margin="0,5"
                    HorizontalAlignment="Stretch"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Issue.IssueCause}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <!--  Phương hướng  -->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Settings" />
                    <TextBlock
                        Margin="5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="PHƯƠNG HƯỚNG KHẮC PHỤC" />
                </StackPanel>

                <TextBox
                    Height="100"
                    MaxHeight="300"
                    Margin="0,5"
                    HorizontalAlignment="Stretch"
                    AcceptsReturn="True"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding Issue.IssueSolution}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <!--  Buttons  -->
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="bnCancel"
                        Width="100"
                        Height="40"
                        Margin="0,20,10,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="Cancel" />
                            <TextBlock>Hủy</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="bnSave"
                        Width="100"
                        Height="40"
                        Margin="0,20,10,10"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="ContentSave" />
                            <TextBlock>Lưu</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
