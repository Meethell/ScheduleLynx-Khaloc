<UserControl
    x:Class="Client.Views.IssueManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Tab menu  -->
        <StackPanel Orientation="Vertical">
            <Button
                x:Name="ToggleModelSelector"
                Height="85"
                Padding="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource MaterialDesignFlatButton}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="5"
                            VerticalAlignment="Stretch"
                            Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Chọn Model"
                            TextAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
        <!--  Model Selector  -->
        <Grid Grid.Column="1" Visibility="{Binding IsModelSelectorVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Manufacturer Selector  -->
                <GroupBox
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    materialDesign:GroupBoxAssist.HeaderPadding="5"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.Header>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                Foreground="White"
                                Kind="Factory" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="Nhà sản xuất" />
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical">
                        <!--  Search Box  -->
                        <TextBox
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Tìm kiếm"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                            FontSize="14"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SearchManufacturer, UpdateSourceTrigger=PropertyChanged}" />
                        <Separator Margin="0,5" />
                        <!--  Manufacturer List  -->
                        <ListBox
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding Manufacturers}"
                            SelectedItem="{Binding SelectedManufacturer}"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="Border"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Country.Name}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
                <!--  Model Selector  -->
                <materialDesign:Card
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="0,0,0,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    Visibility="{Binding IsModelListVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontWeight="Medium"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="{Binding SelectedManufacturer.Name}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}" Text="Xuất xứ: " />
                                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}" Text="{Binding SelectedManufacturer.Country.Name}" />
                            </StackPanel>
                            <TextBox
                                Height="auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.FloatingOffset="0,-25"
                                materialDesign:HintAssist.FloatingScale="1.15"
                                materialDesign:HintAssist.Hint="Tìm kiếm"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                FontSize="14"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SearchModel, UpdateSourceTrigger=PropertyChanged}" />
                            <Separator Margin="0,5" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox
                                Height="auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding Models}"
                                SelectedItem="{Binding SelectedModel}"
                                SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="Border"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="0,0,0,1">
                                            <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding ModelType.Type}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>


            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                ResizeBehavior="PreviousAndCurrent" />
        </Grid>
        <!--  Issue Management  -->
        <materialDesign:Card
            Grid.Column="2"
            Padding="10"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock
                        VerticalAlignment="Top"
                        FontWeight="Medium"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="Danh sách sự cố" />
                    <!--  Nút thêm mới  -->
                    <Button
                        Padding="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action NewIssue()]"
                        materialDesign:HintAssist.HelperText="Thêm mới"
                        IsEnabled="{Binding IsIssueNewAble}"
                        Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,0,0"
                                VerticalAlignment="Center"
                                Kind="Plus" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    materialDesign:ElevationAssist.Elevation="Dp5"
                                    BorderThickness="2"
                                    UniformCornerRadius="5">
                                    <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                        <!--  Title tb  -->
                                        <DockPanel>
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="ListBox" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Padding="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                cal:Message.Attach="[Event Click] = [Action OpenIssueDetailView($eventArgs)]"
                                                Style="{StaticResource MaterialDesignFlatButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Kind="Search" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                        <!--  Description tb  -->
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Text" />
                                            <TextBlock
                                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                Text="{Binding IssueDescription}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

        </materialDesign:Card>
    </Grid>
</UserControl>
