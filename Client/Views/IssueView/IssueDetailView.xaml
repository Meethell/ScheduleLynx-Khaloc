<UserControl
    x:Class="Client.Views.IssueDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <materialDesign:Card
            Grid.Column="0"
            MinWidth="500"
            Margin="10,0,0,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                    <!--  Title tb  -->
                    <DockPanel>
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="ListBox" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="TIÊU ĐỀ" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Margin="0,0"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action EditIssue()]"
                                IsEnabled="{Binding IsReadOnly}"
                                Style="{StaticResource MaterialDesignFlatDarkBgButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Kind="Pencil" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="auto"
                                Height="auto"
                                Margin="5,0"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action DeleteIssueCommand()]"
                                Background="Red"
                                BorderBrush="Transparent"
                                Visibility="{Binding IsDeleteVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Delete" />
                                </StackPanel>
                            </Button>
                            <!--  Close Button  -->
                            <Button
                                Padding="5"
                                Margin="5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action CloseIssue()]"
                                Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Kind="Close" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                        Text="Đóng" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <TextBox
                        Width="{Binding ActualWidth, ElementName=MainStackPanel}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="14"
                        IsReadOnly="{Binding IsReadOnly}"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding Issue.Title}"
                        TextWrapping="Wrap" />
                    <!--  INSTRUMENT DETAILS  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="CHI TIẾT" />
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Instrument Type  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Sort" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Loại thiết bị: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Issue.Model.ModelType.Type}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Instrument Manufacturer  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Factory" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Nhà sản xuất: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Issue.Model.Manufacturer.Name}" />
                        <!--  Model  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Devices" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Model: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Issue.Model.Name}" />
                    </StackPanel>
                    <Separator Margin="0,5" />
                    <!--  Description tb  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Text" />
                        <TextBlock
                            Margin="5"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="MÔ TẢ LỖI" />
                    </StackPanel>
                    <TextBox
                        Height="100"
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        IsReadOnly="{Binding IsReadOnly}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Issue.IssueDescription}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <!--  Nguyên nhân  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Error" />
                        <TextBlock
                            Margin="5"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="NGUYÊN NHÂN" />
                    </StackPanel>
                    <TextBox
                        Height="100"
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        IsReadOnly="{Binding IsReadOnly}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Issue.IssueCause}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <!--  Phương hướng  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Settings" />
                        <TextBlock
                            Margin="5"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="PHƯƠNG HƯỚNG KHẮC PHỤC" />
                    </StackPanel>

                    <TextBox
                        Height="100"
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        IsReadOnly="{Binding IsReadOnly}"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Issue.IssueSolution}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <!--  Buttons  -->
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="bnCancel"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Visibility="{Binding IsUserEditting, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Cancel" />
                                <TextBlock>Hủy</TextBlock>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="bnSave"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Visibility="{Binding IsUserEditting, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSave" />
                                <TextBlock>Lưu</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
        <materialDesign:Card
            Grid.Column="1"
            Margin="10,0,0,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <StackPanel Orientation="Vertical">
                <DockPanel>
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Error" />
                    <TextBlock
                        Margin="5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="CÁC TICKET CÓ LỖI NÀY" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tickets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    materialDesign:ElevationAssist.Elevation="Dp5"
                                    BorderThickness="2"
                                    UniformCornerRadius="5">
                                    <StackPanel
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Orientation="Vertical">
                                        <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Ticket" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="Ticket ID: " />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="{Binding TicketNumber}" />
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="-" />
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="{Binding Title}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="1"
                                                Width="auto"
                                                Height="auto"
                                                Padding="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                                                Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Kind="Search" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Status  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="ListStatus" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="Trạng thái: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Status.Status}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Status.Color}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Priority  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="PriorityHigh" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="Mức độ ưu tiên: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Priority.Name}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Priority.Color}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Ticket Type  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Sort" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="Loại Ticket: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Type.Type}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Type.Color}" />
                                            </StackPanel>
                                            <!--  Created Date  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày tạo: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <!--  OverDue Date  -->
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày đến hạn: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding Overdue, Converter={StaticResource BoolToColorConverter}}"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding DateDue, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <!--  Updated Date  -->
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày cập nhật: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>

        </materialDesign:Card>
    </Grid>
</UserControl>
