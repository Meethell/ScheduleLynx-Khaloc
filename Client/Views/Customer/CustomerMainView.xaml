<UserControl
    x:Class="Client.Views.CustomerMainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">

    <!--  BoolToVis  -->
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>

        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <!--  Navigation Button  -->
                    <RadioButton
                        x:Name="CustomerView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Danh sách khách hàng"
                        IsChecked="{Binding IsCustomerViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                    <RadioButton
                        x:Name="DealerView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Danh sách Dealer"
                        IsChecked="{Binding IsDealerViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                    <RadioButton
                        x:Name="ModelCustomerView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Thống kê Model"
                        IsChecked="{Binding IsModelCustomerViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                    <RadioButton
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Thông tin Dealer"
                        IsChecked="{Binding IsDealerDetailChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Visibility="{Binding IsDealerDetailChecked, Converter={StaticResource BoolToVis}}" />
                    <RadioButton
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Thông tin khác hàng"
                        IsChecked="{Binding IsCustomerDetailChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Visibility="{Binding IsCustomerDetailChecked, Converter={StaticResource BoolToVis}}" />

                </StackPanel>

                <ContentControl
                    x:Name="ActiveItem"
                    Grid.Row="1"
                    Margin="0,5,0,0" />
            </Grid>

        </materialDesign:Card>

    </Grid>
</UserControl>