<UserControl
    x:Class="Client.Views.ModelCustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <CollectionViewSource x:Key="GroupedInstruments" Source="{Binding Instruments}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Customer.Dealer.Name" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Tab menu  -->
        <StackPanel Orientation="Vertical">
            <Button
                x:Name="ToggleModelSelector"
                Height="85"
                Padding="5"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource MaterialDesignFlatButton}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle
                            Width="5"
                            VerticalAlignment="Stretch"
                            Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Chọn Model"
                            TextAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>
        <!--  Model Selector  -->
        <Grid Grid.Column="1" Visibility="{Binding IsModelSelectorVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Manufacturer Selector  -->
                <GroupBox
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    materialDesign:GroupBoxAssist.HeaderPadding="5"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.Header>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                Foreground="White"
                                Kind="Factory" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="Nhà sản xuất" />
                        </StackPanel>
                    </GroupBox.Header>
                    <StackPanel Orientation="Vertical">
                        <!--  Search Box  -->
                        <TextBox
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Tìm kiếm"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                            FontSize="14"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding SearchManufacturer, UpdateSourceTrigger=PropertyChanged}" />
                        <Separator Margin="0,5" />
                        <!--  Manufacturer List  -->
                        <ListBox
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            ItemsSource="{Binding Manufacturers}"
                            SelectedItem="{Binding SelectedManufacturer}"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="Border"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Country.Name}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </GroupBox>
                <!--  Model Selector  -->
                <materialDesign:Card
                    Grid.Column="1"
                    MinWidth="200"
                    Margin="0,0,0,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    Visibility="{Binding IsModelListVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <TextBlock
                                FontWeight="Medium"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="{Binding SelectedManufacturer.Name}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}" Text="Xuất xứ: " />
                                <TextBlock Style="{StaticResource MaterialDesignCaptionTextBlock}" Text="{Binding SelectedManufacturer.Country.Name}" />
                            </StackPanel>
                            <TextBox
                                Height="auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                materialDesign:HintAssist.FloatingOffset="0,-25"
                                materialDesign:HintAssist.FloatingScale="1.15"
                                materialDesign:HintAssist.Hint="Tìm kiếm"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                FontSize="14"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                Text="{Binding SearchModel, UpdateSourceTrigger=PropertyChanged}" />
                            <Separator Margin="0,5" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ListBox
                                Height="auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                ItemsSource="{Binding Models}"
                                SelectedItem="{Binding SelectedModel}"
                                SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            x:Name="Border"
                                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="0,0,0,1">
                                            <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Model.Name}"
                                                    TextWrapping="Wrap" />
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Model.ModelType.Type}" />
                                                <TextBlock
                                                    HorizontalAlignment="Stretch"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Count, StringFormat='Số lượng: {0}'}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                ResizeBehavior="PreviousAndCurrent" />
        </Grid>
        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <!--  Issue Management  -->
            <materialDesign:Card
                Grid.Column="0"
                Padding="10"
                materialDesign:ElevationAssist.Elevation="Dp5"
                UniformCornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="Danh sách Thiết bị" />
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedInstruments}}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <Expander IsExpanded="True">
                                                            <Expander.Header>
                                                                <DockPanel>
                                                                    <!--  Thêm Specification  -->
                                                                    <TextBlock
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                        Text="{Binding Name}" />
                                                                    <TextBlock
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                                        Text="{Binding ItemCount, StringFormat=' (Số lượng: {0})'}" />
                                                                </DockPanel>
                                                            </Expander.Header>
                                                            <ItemsPresenter />
                                                        </Expander>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card
                                        Padding="10"
                                        HorizontalAlignment="Stretch"
                                        materialDesign:ElevationAssist.Elevation="Dp5"
                                        BorderThickness="2"
                                        UniformCornerRadius="5">
                                        <StackPanel
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Orientation="Vertical">

                                            <DockPanel
                                                Grid.Column="0"
                                                Margin="5,0"
                                                HorizontalAlignment="Stretch">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Devices" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                    Text="{Binding Name}" />
                                                <Button
                                                    Grid.Column="1"
                                                    Width="auto"
                                                    Height="auto"
                                                    Padding="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    cal:Message.Attach="[Event Click] = [Action ViewInstrument($eventArgs)]"
                                                    Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="Search" />
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>
                                            <!--  Serial Number  -->
                                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Barcode" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding SerialNumber}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                                <!--  Dealer  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Company" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Customer.Dealer.Name}" />
                                            </StackPanel>
                                            <!--  Customer  -->
                                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Account" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Customer.Name}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </materialDesign:Card>
        </Grid>

    </Grid>
</UserControl>
