<UserControl
    x:Class="Client.Views.NewEditTicketView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <Grid>
        <materialDesign:Card
            Margin="10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="MainStackPanel"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
                    <DockPanel>
                        <StackPanel
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <!--  Header  -->
                            <TextBlock
                                x:Name="tbHeader"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
                            <!--  TicketID  -->
                            <TextBlock
                                Margin="5,10,0,0"
                                HorizontalAlignment="Left"
                                FontWeight="Bold"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                Text="{Binding Ticket.TicketNumber}" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <!--  Created Date  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Regular"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Ngày tạo: " />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Regular"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                            <!--  Date Updated  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,5"
                                HorizontalAlignment="Left"
                                FontSize="14"
                                FontWeight="Regular"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Ngày cập nhật: " />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Regular"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                            <!--  Status  -->
                            <StackPanel
                                Grid.Row="2"
                                Grid.Column="0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <!--  Circle Color indicator  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="5,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Ticket.Status.Color}" />
                                <TextBlock
                                    Margin="0,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Regular"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Trạng thái: " />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.Status.Status}" />
                        </Grid>
                    </DockPanel>


                    <!--  Title tb  -->
                    <TextBox
                        Width="{Binding ActualWidth, ElementName=MainStackPanel}"
                        Margin="0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.FloatingOffset="0,-25"
                        materialDesign:HintAssist.FloatingScale="1.15"
                        materialDesign:HintAssist.Hint="Tiêu đề"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TextBox"
                        materialDesign:TextFieldAssist.LeadingIconSize="20"
                        FontSize="14"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding Ticket.Title}" />
                    <StackPanel Orientation="Horizontal">
                        <!--  TicketType cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="HamburgerMenu" />
                        <ComboBox
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Loại Dịch vụ"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Type"
                            FontSize="14"
                            ItemsSource="{Binding TicketTypes}"
                            SelectedItem="{Binding Ticket.Type}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                        <!--  TicketPriority cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="20,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="PriorityHigh" />
                        <ComboBox
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Mức độ ưu tiên"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            ItemsSource="{Binding TicketPriorities}"
                            SelectedItem="{Binding Ticket.Priority}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  TicketType cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="BagSuitcase" />
                        <ComboBox
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Phương thức xử lý"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Type"
                            FontSize="14"
                            ItemsSource="{Binding TicketServiceTypes}"
                            SelectedItem="{Binding Ticket.ServiceType}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  Customer cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Account" />
                        <ComboBox
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Khách hàng"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            IsEditable="True"
                            IsEnabled="{Binding IsNew}"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SelectedCustomer}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            Text="{Binding CustomerSearchText}" />
                        <!--  Affected Instrument cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="20,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Devices" />
                        <ComboBox
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Thiết bị"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            IsEnabled="{Binding IsNew}"
                            ItemsSource="{Binding Instruments}"
                            SelectedItem="{Binding SelectedInstrument}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Margin="5,0,0,0" Text="{Binding SerialNumber}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <!--  Issue cb  -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <DockPanel
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,15"
                                VerticalAlignment="Bottom"
                                Foreground="#707070"
                                Kind="Alert" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="2"
                                MinWidth="200"
                                Margin="0,10"
                                HorizontalAlignment="Left"
                                materialDesign:HintAssist.FloatingOffset="0,-25"
                                materialDesign:HintAssist.FloatingScale="1.15"
                                materialDesign:HintAssist.Hint="Issue"
                                materialDesign:HintAssist.IsFloating="True"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                DisplayMemberPath="Title"
                                FontSize="14"
                                IsEditable="True"
                                ItemsSource="{Binding Issues}"
                                SelectedItem="{Binding Ticket.Issue}"
                                Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                                Text="{Binding IssueSearchText}" />
                        </DockPanel>
                        <!--  New Issue Button  -->
                        <Button
                            x:Name="btNewIssue"
                            Grid.Column="1"
                            Width="85"
                            Height="40"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            IsEnabled="{Binding IsNewIssueEnabled}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.Content>
                                <DockPanel>
                                    <materialDesign:PackIcon VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Kind>Plus</materialDesign:PackIcon.Kind>
                                    </materialDesign:PackIcon>
                                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">New</TextBlock>
                                </DockPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                    <!--  Due Day  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Calendar" />
                        <DatePicker
                            Width="300"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Ngày đến hạn"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            IsEnabled="{Binding IsDateDueEnable}"
                            SelectedDate="{Binding Ticket.DateDue}"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                    </StackPanel>
                    <!--  Description tb  -->
                    <!--  Mô Tả  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="TextBox" />
                        <TextBlock
                            Margin="5,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#707070"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="MÔ TẢ" />
                    </StackPanel>
                    <TextBox
                        x:Name="Description"
                        MinHeight="150"
                        MaxHeight="400"
                        Margin="0,5"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Ticket.Description}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <!--  Nguyên nhân  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="CommentAlert" />
                        <TextBlock
                            Margin="5,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#707070"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="NGUYÊN NHÂN" />
                    </StackPanel>
                    <TextBox
                        MinHeight="150"
                        MaxHeight="400"
                        Margin="0,5"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Ticket.Cause}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <!--  Phương hướng  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="LightbulbOn" />
                        <TextBlock
                            Margin="5,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#707070"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="PHƯƠNG HƯỚNG KHẮC PHỤC" />
                    </StackPanel>
                    <TextBox
                        MinHeight="150"
                        MaxHeight="400"
                        Margin="0,5"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Ticket.Solution}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <!--  Kết luận  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="CommentCheck" />
                        <TextBlock
                            Margin="5,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="#707070"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="KẾT LUẬN" />
                    </StackPanel>
                    <TextBox
                        MinHeight="150"
                        MaxHeight="400"
                        Margin="0,5"
                        Padding="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="12"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Ticket.Conclusion}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                    <!--  Buttons  -->
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btCancel"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Cancel" />
                                <TextBlock>Hủy</TextBlock>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="btSave"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSave" />
                                <TextBlock>Lưu</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

        </materialDesign:Card>
    </Grid>
</UserControl>
