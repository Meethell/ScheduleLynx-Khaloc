<UserControl
    x:Class="Client.Views.TicketPendingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <Grid>
        <materialDesign:Card
            Margin="10,0,10,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  TICKET TITLE  -->
                <DockPanel HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="ReceiptClock" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="TICKET ĐANG CHỜ" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Search TextBox  -->
                        <TextBox
                            x:Name="SearchText"
                            Height="auto"
                            MinWidth="150"
                            MaxWidth="300"
                            Margin="5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-20"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Tìm kiếm"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                            FontSize="14"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
                <!--  Seperator  -->
                <Separator Grid.Row="1" Margin="0,10" />
                <DataGrid
                    Grid.Row="2"
                    cal:Message.Attach="[Event SelectionChanged] = [Action OpenTicketDetailViewCommand()]"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="12"
                    IsEnabled="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding ShowTickets}"
                    SelectedItem="{Binding SelectedTicket}"
                    SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!--  Instrument Title  -->
                        <DataGridTemplateColumn
                            Width="250"
                            MinWidth="150"
                            MaxWidth="350"
                            Header="Tên Thẻ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Ticket: {0} - {1}">
                                                    <Binding Path="Ticket.TicketNumber" />
                                                    <Binding Path="Ticket.Title" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap">
                                            <Run Text="Số Serial: " />
                                            <Run Text="{Binding Ticket.Instrument.SerialNumber}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Customer  -->
                        <DataGridTemplateColumn
                            Width="150"
                            MinWidth="150"
                            MaxWidth="300"
                            Header="Khách hàng">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontWeight="Medium"
                                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                            Text="{Binding Ticket.Instrument.Customer.Name}"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextAlignment="Left"
                                            TextWrapping="Wrap">
                                            <Run Text="Địa chỉ lắp đặt: " />
                                            <Run Text="{Binding Ticket.Instrument.Location}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Người được giao  -->
                        <DataGridTemplateColumn
                            Width="150"
                            MinWidth="150"
                            MaxWidth="300"
                            Header="Người được giao">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ItemsSource="{Binding AssignUsers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding Name}"
                                                        TextAlignment="Center"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Ticket Type  -->
                        <DataGridTemplateColumn Header="Loại Thẻ">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Ticket.Type.Color}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Ticket.Type.Type}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Priority  -->
                        <DataGridTemplateColumn Header="Ưu tiên">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Ticket.Priority.Color}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Ticket.Priority.Name}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Created Date  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Ngày tạo">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Ticket.DateCreated" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Due Date  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Ngày đến hạn">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{Binding Ticket.Overdue, Converter={StaticResource BoolToColorConverter}}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Ticket.DateDue" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Status  -->
                        <DataGridTemplateColumn Header="Trạng thái">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Ticket.Status.Color}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Ticket.Status.Status}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Update Date  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Cập nhật">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Ticket.DateUpdated" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>