<UserControl
    x:Class="Client.Views.TicketDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
        <domain:CurrencyVNDConverter x:Key="CurrencyVNDConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />
        <materialDesign:Card
            Grid.Column="0"
            MinWidth="500"
            Margin="10,0,0,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0">
                    <StackPanel
                        Margin="0,0,5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="30"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="Ticket" />
                                <TextBlock
                                    Margin="5,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="Số Thẻ: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="{Binding Ticket.TicketNumber}" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="-" />
                                <TextBlock
                                    Margin="10"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                    Text="{Binding Ticket.Title}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button
                                    x:Name="EditTicket"
                                    Grid.Column="1"
                                    Width="auto"
                                    Height="auto"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    cal:Message.Attach="[Event Click] = [Action EditTicket()]"
                                    Style="{StaticResource MaterialDesignFlatDarkButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="5,0,10,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                                            Text="Chỉnh sửa" />
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="Pencil" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="auto"
                                    Height="auto"
                                    Padding="5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    cal:Message.Attach="[Event Click] = [Action DeleteTicketCommand()]"
                                    Background="Red"
                                    BorderBrush="Transparent"
                                    Visibility="{Binding IsDeleteVisible, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!--  Created Date  -->
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Calendar" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Ngày tạo: " />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                            <!--  OverDue Date  -->
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="30,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Calendar" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Ngày đến hạn: " />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{Binding Ticket.Overdue, Converter={StaticResource BoolToColorConverter}}"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.DateDue, StringFormat={}{0:dd/MM/yyyy}}" />

                        </StackPanel>
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <!--  Updated Date  -->
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Calendar" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Ngày cập nhật: " />
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Ticket.DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                        </StackPanel>
                        <!--  Seperator  -->
                        <Separator Margin="0,5" />
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="InfoBox" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="CHI TIẾT" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,5" Orientation="Horizontal">
                                <!--  Status  -->
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="ListStatus" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Medium"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Trạng thái: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="{Binding Ticket.Status.Status}" />
                                <!--  Circle Color indicator  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Ticket.Status.Color}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Orientation="Horizontal">
                                <!--  Priority  -->
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="30,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="PriorityHigh" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Medium"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Mức độ ưu tiên: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="{Binding Ticket.Priority.Name}" />
                                <!--  Circle Color indicator  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Ticket.Priority.Color}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Margin="0,5"
                                Orientation="Horizontal">
                                <!--  Ticket Type  -->
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="Sort" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Medium"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Loại Dịch vụ: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="{Binding Ticket.Type.Type}" />
                                <!--  Circle Color indicator  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Ticket.Type.Color}" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,5,0,0"
                                Orientation="Horizontal">
                                <!--  Ticket Type  -->
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="30,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                    Kind="BagSuitcase" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Medium"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Phương thức xử lý: " />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="{Binding Ticket.ServiceType.Type}" />
                                <!--  Circle Color indicator  -->
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Fill="{Binding Ticket.ServiceType.Color}" />
                            </StackPanel>
                        </Grid>


                        <Separator Margin="0,10" />
                        <!--  Issue tb  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="ReportProblem" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="LỖI" />
                            <!--  Nút xem Issue  -->
                            <Button
                                Width="auto"
                                Height="auto"
                                Padding="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action OpenIssueDetail()]"
                                Style="{StaticResource MaterialDesignFlatDarkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Search" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBox
                            MaxHeight="300"
                            Margin="0,5"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Ticket.Issue.Title}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <!--  Description tb  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="ListBox" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="MÔ TẢ LỖI" />
                        </StackPanel>

                        <TextBox
                            MaxHeight="300"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Ticket.Description}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <!--  Cause tb  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="CommentAlert" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="NGUYÊN NHÂN" />
                        </StackPanel>

                        <TextBox
                            MaxHeight="300"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Ticket.Cause}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  Solution tb  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="LightbulbOn" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="PHƯƠNG HƯỚNG KHẮC PHỤC" />
                        </StackPanel>

                        <TextBox
                            MaxHeight="300"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Ticket.Solution}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />

                        <!--  List view Spare Part  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="WrenchCog" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="PHỤ TÙNG THAY THẾ" />
                            <!--  Button Add Spare Part  -->
                            <Button
                                Height="20"
                                Margin="5,0,0,0"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action AddSparePart()]"
                                materialDesign:HintAssist.HelperText="Thêm mới"
                                IsEnabled="{Binding IsIssueNewAble}"
                                Style="{StaticResource MaterialDesignFlatDarkBgButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        Kind="Plus" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!--  List View  -->
                        <ListView
                            MaxHeight="300"
                            ItemsSource="{Binding TicketSpareParts}"
                            SelectedItem="{Binding SelectedTicketSparePart}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn DisplayMemberBinding="{Binding SparePart.Name}" Header="Tên phụ tùng" />
                                    <GridViewColumn DisplayMemberBinding="{Binding SparePart.PartNumber}" Header="Mã phụ tùng" />
                                    <GridViewColumn DisplayMemberBinding="{Binding SerialNumber}" Header="Số Seri" />
                                    <GridViewColumn DisplayMemberBinding="{Binding Quantity}" Header="Số lượng" />
                                    <GridViewColumn Header="Xóa">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <!--  DeleteButton  -->
                                                <Button
                                                    Width="auto"
                                                    Height="auto"
                                                    Padding="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    cal:Message.Attach="[Event Click] = [Action DeleteSparePartCommand($dataContext)]"
                                                    Background="Red"
                                                    BorderBrush="Transparent">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="Delete" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <!--  Solution tb  -->
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="CommentCheck" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="KẾT LUẬN" />
                        </StackPanel>

                        <TextBox
                            MaxHeight="300"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Stretch"
                            FontSize="14"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Text="{Binding Ticket.Conclusion}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                        <!--  Upload File  -->
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="File" />
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="TẢI LÊN TỆP" />
                            <!--  Upload Button  -->
                            <Button
                                Width="auto"
                                Height="auto"
                                Margin="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action UploadFile()]"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                Visibility="{Binding IsUploadVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Upload" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                        Text="Tải lên File" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <materialDesign:Card
                            MinHeight="80"
                            MaxHeight="400"
                            Margin="0,0,0,10"
                            Padding="10"
                            BorderBrush="#4D4D4D"
                            BorderThickness="1"
                            UniformCornerRadius="5">
                            <ListBox
                                cal:Message.Attach="[MouseDoubleClick] = [Action OpenFile()]"
                                ItemsSource="{Binding TicketFiles}"
                                SelectedItem="{Binding SelectedTicketFile}">
                                <ListBox.ContextMenu>
                                    <ContextMenu MinWidth="200">
                                        <MenuItem cal:Message.Attach="[Click] = [Action OpenFile()]" Header="Mở File">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="Folder" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem cal:Message.Attach="[Click] = [Action DeleteFile()]" Header="Xóa">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="Delete" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Vertical" ToolTip="{Binding FileName}">
                                            <materialDesign:PackIcon
                                                Width="50"
                                                Height="50"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="File" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="jpg">
                                                                <Setter Property="Kind" Value="Image" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="pdf">
                                                                <Setter Property="Kind" Value="FilePdfBox" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="docx">
                                                                <Setter Property="Kind" Value="FileWord" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="xlsx">
                                                                <Setter Property="Kind" Value="MicrosoftExcel" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="pptx">
                                                                <Setter Property="Kind" Value="MicrosoftPowerpoint" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value="Other">
                                                                <Setter Property="Kind" Value="File" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>
                                            <TextBlock
                                                MaxWidth="50"
                                                Margin="10,0,0,0"
                                                HorizontalAlignment="Center"
                                                Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                                Text="{Binding FileName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </materialDesign:Card>

                        <!--  Công tác phí  -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsExpenseVisible, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Bitcoin" />
                            <TextBlock
                                Margin="5"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="CÔNG TÁC PHÍ" />
                        </StackPanel>
                        <DataGrid
                            Grid.Row="1"
                            MinHeight="150"
                            Margin="0,10,0,10"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsEnabled="{Binding IsExpenseEnable}"
                            IsReadOnly="{Binding IsExpenseReadOnly}"
                            ItemsSource="{Binding Expenses}"
                            SelectedItem="{Binding SelectedExpense}"
                            SelectionMode="Single"
                            Visibility="{Binding IsExpenseVisible, Converter={StaticResource BoolToVis}}">
                            <DataGrid.Resources>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!--  Expenses Name  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                    Header="Nội dung">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="Name" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  Expenses Name  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                    Header="Chi phí">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Converter="{StaticResource CurrencyVNDConverter}" Path="Amount" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  Expenses Name  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                    Header="Số lượng">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="Count" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  Expenses Name  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                    Header="Tổng">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding
                                            Converter="{StaticResource CurrencyVNDConverter}"
                                            Mode="OneWay"
                                            Path="Total" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  Expenses Notes  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    Header="Ghi chú">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="AcceptsReturn" Value="True" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="Notes" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Buttons  -->
                        <StackPanel
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal"
                            Visibility="{Binding IsExpenseVisible, Converter={StaticResource BoolToVis}}">
                            <Button
                                x:Name="bnExpenseNew"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Thêm mới"
                                IsEnabled="{Binding IsExpenseNewButtonEnable}" />
                            <Button
                                x:Name="bnExpenseEdit"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Sửa"
                                IsEnabled="{Binding IsExpenseEditButtonEnable}"
                                Visibility="{Binding IsExpenseReadOnly, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnExpenseSave"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Lưu"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding IsExpenseUserEditting, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnExpenseCancel"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Hủy"
                                Visibility="{Binding IsExpenseUserEditting, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnExpenseDelete"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Xóa"
                                IsEnabled="{Binding IsExpenseDeleteButtonEnable}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <!--  Start Progress Button  -->
                    <Button
                        Width="auto"
                        Height="auto"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action StartProgress()]"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                        Visibility="{Binding IsStartProgressVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Play" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Bắt đầu xử lý" />
                        </StackPanel>
                    </Button>
                    <!--  Resolved  -->
                    <Button
                        Width="auto"
                        Height="auto"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action ResolveTicket()]"
                        IsEnabled="{Binding IsResolveEnable}"
                        Style="{StaticResource MaterialDesignRaisedDarkButton}"
                        Visibility="{Binding IsResolvedVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Check" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Đóng thẻ" />
                        </StackPanel>
                    </Button>
                    <!--  ReOpen  -->
                    <Button
                        Width="auto"
                        Height="auto"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action ReopenTicket()]"
                        Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                        Visibility="{Binding IsReopenVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Replay" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Mở lại thẻ" />
                        </StackPanel>
                    </Button>
                    <!--  Cancel  -->
                    <Button
                        Width="auto"
                        Height="auto"
                        Margin="5"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action CancelTicket()]"
                        Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                        Visibility="{Binding IsCancelledVisible, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Cancel" />
                            <TextBlock
                                Margin="5,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Hủy thẻ" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Grid>

        </materialDesign:Card>
        <materialDesign:Card
            Grid.Column="2"
            Margin="0,0,10,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <ScrollViewer>
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
                    <!--  ADDITIONAL INFORMATION  -->
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="InfoBox" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="THÔNG TIN THÊM" />
                    </StackPanel>
                    <!--  Người được giao  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="NGƯỜI ĐƯỢC GIAO " />
                        <materialDesign:PopupBox
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            PlacementMode="BottomAndAlignRightEdges"
                            StaysOpen="True"
                            Visibility="{Binding IsPickUsersVisible, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PopupBox.ToggleContent>
                                <materialDesign:PackIcon Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Kind="TagEdit" />
                            </materialDesign:PopupBox.ToggleContent>
                            <ScrollViewer MaxHeight="500">
                                <ItemsControl Margin="5" ItemsSource="{Binding PickUsers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox
                                                    Width="15"
                                                    Height="15"
                                                    Margin="5"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                                <!--  User Avatar  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Account" />
                                                <StackPanel VerticalAlignment="Center" Orientation="Vertical">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Bold"
                                                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </materialDesign:PopupBox>
                    </StackPanel>
                    <ItemsControl
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding AssignUsers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!--  User Avatar  -->
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Kind="Account" />
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="{Binding Name}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!--  Seperator  -->
                    <Separator Margin="0,10" />
                    <!--  Contact List  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="LIÊN HỆ" />
                    <ListBox
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Contacts}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="8"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="20"
                                            Height="20"
                                            Margin="5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                            Kind="Account" />
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="Bold"
                                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                Text="{Binding Role}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                Text="{Binding PhoneNumber}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                    <!--  Seperator  -->
                    <Separator Margin="0,10" />
                    <!--  Customer Detail  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="KHÁCH HÀNG" />

                    <StackPanel Orientation="Horizontal">
                        <!--  Customer Name  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Account" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Ticket.Instrument.Customer.Name}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <!--  Address  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="MapMarker" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Ticket.Instrument.Customer.Address}" />
                    </StackPanel>
                    <!--  Seperator  -->
                    <Separator Margin="0,10" />
                    <!--  Instrument Detail  -->
                    <DockPanel>
                        <TextBlock
                            Margin="0,5"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="THIẾT BỊ" />
                        <!--  View Button with OnlyIcon  -->
                        <Button
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            cal:Message.Attach="[Event Click] = [Action OpenInstrumentDetail()]"
                            Style="{StaticResource MaterialDesignFlatDarkButton}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Search" />
                        </Button>
                    </DockPanel>


                    <!--  Name  -->
                    <TextBlock
                        Margin="0,5"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Ticket.Instrument.Name}" />
                    <!--  Serial Number  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Barcode" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Ticket.Instrument.SerialNumber}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Instrument Type  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Sort" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Ticket.Instrument.Model.ModelType.Type}" />
                    </StackPanel>
                    <!--  Model  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Devices" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Ticket.Instrument.Model.Name}" />
                    </StackPanel>

                    <!--  Seperator  -->
                    <Separator Margin="0,10" />
                    <!--  Related Ticket  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="CÁC THẺ LIÊN QUAN" />
                    <ScrollViewer
                        MaxHeight="500"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
                        <ListBox
                            Margin="0,5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            cal:Message.Attach="[MouseDoubleClick] = [Action OpenTicketDetail()]"
                            ItemsSource="{Binding RelatedTickets}"
                            SelectedItem="{Binding SelectedRelatedTicket}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Padding="8"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Ticket" />
                                            <StackPanel Orientation="Vertical">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                        Text="Ticket " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                        Text="{Binding TicketNumber}" />
                                                </StackPanel>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Title}" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>
