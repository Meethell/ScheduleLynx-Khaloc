<UserControl
    x:Class="Client.Views.TestUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <Grid>
        <materialDesign:Card
            Padding="10"
            HorizontalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp5"
            BorderThickness="2"
            UniformCornerRadius="5">
            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Orientation="Vertical">
                <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Ticket" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="Số thẻ: " />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding TicketNumber}" />
                    <TextBlock
                        Margin="5,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="-" />
                    <TextBlock
                        Margin="5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="{Binding Title}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="1"
                        Width="auto"
                        Height="auto"
                        Padding="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                        Style="{StaticResource MaterialDesignFlatDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Search" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <!--  Status  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="ListStatus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Trạng thái: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding Status.Status}" />
                        <!--  Circle Color indicator  -->
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Status.Color}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <!--  Priority  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="PriorityHigh" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Mức độ ưu tiên: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding Priority.Name}" />
                        <!--  Circle Color indicator  -->
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Priority.Color}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <!--  Ticket Type  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Sort" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Loại Ticket: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding Type.Type}" />
                        <!--  Circle Color indicator  -->
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Type.Color}" />
                    </StackPanel>
                    <!--  Created Date  -->
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Calendar" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Ngày tạo: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <!--  OverDue Date  -->
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Calendar" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Ngày đến hạn: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{Binding Overdue, Converter={StaticResource BoolToColorConverter}}"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding DateDue, StringFormat={}{0:dd/MM/yyyy}}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="2"
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <!--  Updated Date  -->
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Calendar" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="Ngày cập nhật: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignCaptionTextBlock}"
                            Text="{Binding DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                    </StackPanel>
                </Grid>
                <Separator
                    Height="1"
                    Margin="0,10,0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="15"
                        Height="15"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="CogBox" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                        Text="Phụ tùng thay thế" />
                </StackPanel>

                <!--  List View  -->
                <ListView
                    MaxHeight="300"
                    ItemsSource="{Binding TicketSpareParts}"
                    SelectedItem="{Binding SelectedTicketSparePart}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn DisplayMemberBinding="{Binding SparePart.Name}" Header="Tên phụ tùng" />
                            <GridViewColumn DisplayMemberBinding="{Binding SparePart.PartNumber}" Header="Mã phụ tùng" />
                            <GridViewColumn DisplayMemberBinding="{Binding SerialNumber}" Header="Số Seri" />
                            <GridViewColumn DisplayMemberBinding="{Binding Quantity}" Header="Số lượng" />
                            <GridViewColumn Header="Xóa">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!--  DeleteButton  -->
                                        <Button
                                            Width="auto"
                                            Height="auto"
                                            Padding="5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            cal:Message.Attach="[Event Click] = [Action DeleteSparePartCommand($dataContext)]"
                                            Background="Red"
                                            BorderBrush="Transparent">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Kind="Delete" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
