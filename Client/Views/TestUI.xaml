<UserControl
    x:Class="Client.Views.TestUI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <Grid>
        <materialDesign:Card
            Padding="10"
            HorizontalAlignment="Stretch"
            materialDesign:ElevationAssist.Elevation="Dp5"
            BorderThickness="2"
            UniformCornerRadius="5">
            <StackPanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Orientation="Vertical">

                <DockPanel
                    Grid.Column="0"
                    Margin="5,0"
                    HorizontalAlignment="Stretch">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Devices" />
                    <TextBlock
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="{Binding Name}" />
                    <Button
                        Grid.Column="1"
                        Width="auto"
                        Height="auto"
                        Padding="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        cal:Message.Attach="[Event Click] = [Action ViewInstrument($eventArgs)]"
                        Style="{StaticResource MaterialDesignFlatDarkButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Search" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <!--  Serial Number  -->
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Barcode" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding SerialNumber}" />
                </StackPanel>
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <!--  Dealer  -->
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Company" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Customer.Dealer.Name}" />
                </StackPanel>
                <!--  Customer  -->
                <StackPanel Margin="0,5" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        Kind="Account" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                        Text="{Binding Customer.Name}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
