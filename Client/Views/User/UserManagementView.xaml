<UserControl
    x:Class="Client.Views.UserManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  User Management  -->
        <materialDesign:Card
            Margin="10,0,0,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  TICKET TITLE  -->
                <DockPanel HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="AccountSupervisor" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="QUẢN LÝ NGƯỜI DÙNG" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  New Button  -->
                        <Button
                            Width="50"
                            Height="30"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Right"
                            cal:Message.Attach="[Event Click] = [Action New()]"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            Visibility="{Binding IsNotEditing, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="AccountAdd" />
                        </Button>
                    </StackPanel>
                </DockPanel>
                <!--  Seperator  -->
                <Separator Grid.Row="1" Margin="0,10" />
                <DataGrid
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="12"
                    IsEnabled="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding AccountUsers}"
                    SelectedItem="{Binding SelectedUser}"
                    SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <!--  View  -->
                        <DataGridTemplateColumn Header="Chỉnh sửa">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="auto"
                                        Height="auto"
                                        Padding="5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        cal:Message.Attach="[Event Click] = [Action ViewUser()]"
                                        Style="{StaticResource MaterialDesignFlatDarkButton}">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Kind="AccountCog" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--  Full Name Column  -->
                        <materialDesign:DataGridTextColumn Header="Tên User">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="AcceptsReturn" Value="True" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Name" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Role  -->
                        <materialDesign:DataGridTextColumn Header="Vai trò">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="AcceptsReturn" Value="True" />
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Role" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Status Column  -->
                        <DataGridCheckBoxColumn Binding="{Binding IsActivated}" Header="Tình trạng kích hoạt">
                            <DataGridCheckBoxColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignCheckBox}" TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="cal:Message.Attach" Value="[Event Checked] = [Action OnChecked()]; [Event Unchecked] = [Action OnUnChecked()]" />
                                </Style>
                            </DataGridCheckBoxColumn.ElementStyle>
                            <DataGridCheckBoxColumn.EditingElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignCheckBox}" TargetType="CheckBox">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="cal:Message.Attach" Value="[Event Checked] = [Action OnChecked()]; [Event Unchecked] = [Action OnUnChecked()]" />
                                </Style>
                            </DataGridCheckBoxColumn.EditingElementStyle>
                        </DataGridCheckBoxColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
        <GridSplitter
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ResizeDirection="Columns" />
        <!--  Ticket Viewer  -->
        <materialDesign:Card
            Grid.Column="2"
            Margin="0,0,10,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  TICKET TITLE  -->
                <DockPanel HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="ChartBar" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="Thống Kê Thẻ Kỹ Thuật" />
                    </StackPanel>
                </DockPanel>
                <!--  Seperator  -->
                <Separator Grid.Row="1" Margin="0,10" />

                <StackPanel
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    Orientation="Horizontal">
                    <!--  Fist Date  -->
                    <DatePicker
                        Width="150"
                        Margin="5,0"
                        SelectedDate="{Binding DateFrom}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                    <!--  Last Date  -->
                    <DatePicker
                        Width="150"
                        Margin="5,0"
                        SelectedDate="{Binding DateTo}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                    <!--  Button Query  -->
                    <Button
                        Margin="5,0"
                        Padding="10,0"
                        cal:Message.Attach="[Event Click] = [Action QuerySparePartStatistics()]"
                        Style="{StaticResource MaterialDesignOutlinedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Magnify" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer
                    Grid.Row="3"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="Summation" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MaterialDesignBody2TextBlock}">
                                        <Run FontWeight="Medium" Text="Số thẻ kỹ thuật: " />
                                        <Run Text="{Binding TicketCount}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer
                                Grid.Row="2"
                                MaxHeight="500"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical">
                                    <ItemsControl ItemsSource="{Binding Tickets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card
                                                    Padding="10"
                                                    HorizontalAlignment="Stretch"
                                                    materialDesign:ElevationAssist.Elevation="Dp5"
                                                    BorderThickness="2"
                                                    UniformCornerRadius="5">
                                                    <StackPanel
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Orientation="Vertical">
                                                        <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                                            <materialDesign:PackIcon
                                                                Width="20"
                                                                Height="20"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                Kind="Ticket" />
                                                            <TextBlock
                                                                Margin="5,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="Số thẻ: " />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="{Binding TicketNumber}" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="-" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="{Binding Title}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Width="auto"
                                                                Height="auto"
                                                                Padding="5"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                                                                Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Kind="Search" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DockPanel>
                                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Status  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="ListStatus" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Trạng thái: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Status.Status}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Status.Color}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Priority  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="PriorityHigh" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Mức độ ưu tiên: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Priority.Name}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Priority.Color}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Ticket Type  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="Sort" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Loại Ticket: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Type.Type}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Type.Color}" />
                                                            </StackPanel>
                                                            <!--  Created Date  -->
                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Orientation="Horizontal">
                                                                <materialDesign:PackIcon
                                                                    Width="15"
                                                                    Height="15"
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="Calendar" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Ngày tạo: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="1"
                                                                Orientation="Horizontal">
                                                                <!--  OverDue Date  -->
                                                                <materialDesign:PackIcon
                                                                    Width="15"
                                                                    Height="15"
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="Calendar" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Ngày đến hạn: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{Binding Overdue, Converter={StaticResource BoolToColorConverter}}"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding DateDue, StringFormat={}{0:dd/MM/yyyy}}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="2"
                                                                Grid.Column="1"
                                                                Orientation="Horizontal">
                                                                <!--  Updated Date  -->
                                                                <materialDesign:PackIcon
                                                                    Width="15"
                                                                    Height="15"
                                                                    Margin="30,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="Calendar" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Ngày cập nhật: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </materialDesign:Card>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Kind="ClockAlert" />
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource MaterialDesignBody2TextBlock}">
                                        <Run FontWeight="Medium" Text="Số thẻ quá hạn: " />
                                        <Run Foreground="Red" Text="{Binding TicketOverdueCount}" />
                                    </TextBlock>
                                </StackPanel>
                            </Expander.Header>
                            <ScrollViewer
                                Grid.Row="2"
                                MaxHeight="500"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Orientation="Vertical">
                                    <ItemsControl ItemsSource="{Binding TicketsOverdue}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <materialDesign:Card
                                                    Padding="10"
                                                    HorizontalAlignment="Stretch"
                                                    materialDesign:ElevationAssist.Elevation="Dp5"
                                                    BorderThickness="2"
                                                    UniformCornerRadius="5">
                                                    <StackPanel
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        Orientation="Vertical">
                                                        <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                                            <materialDesign:PackIcon
                                                                Width="20"
                                                                Height="20"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                Kind="Ticket" />
                                                            <TextBlock
                                                                Margin="5,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="Số thẻ: " />
                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="{Binding TicketNumber}" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="-" />
                                                            <TextBlock
                                                                Margin="5,0"
                                                                HorizontalAlignment="Stretch"
                                                                VerticalAlignment="Center"
                                                                FontWeight="Medium"
                                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                Text="{Binding Title}"
                                                                TextWrapping="Wrap" />
                                                            <Button
                                                                Grid.Column="1"
                                                                Width="auto"
                                                                Height="auto"
                                                                Padding="5"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Center"
                                                                cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                                                                Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        Kind="Search" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DockPanel>
                                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="auto" />
                                                                <ColumnDefinition Width="auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition Height="auto" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Status  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="ListStatus" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Trạng thái: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Status.Status}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Status.Color}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Priority  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="PriorityHigh" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Mức độ ưu tiên: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Priority.Name}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Priority.Color}" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal">
                                                                <!--  Ticket Type  -->
                                                                <materialDesign:PackIcon
                                                                    Width="20"
                                                                    Height="20"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                    Kind="Sort" />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="Medium"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="Loại Ticket: " />
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                                    Text="{Binding Type.Type}" />
                                                                <!--  Circle Color indicator  -->
                                                                <Ellipse
                                                                    Width="10"
                                                                    Height="10"
                                                                    Margin="5,0"
                                                                    VerticalAlignment="Center"
                                                                    Fill="{Binding Type.Color}" />
                                                            </StackPanel>
                                                            <!--  Created Date  -->
                                                            <StackPanel
                                                                Grid.Row="0"
