<Window
    x:Class="Client.Views.EditAccountView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:Client.Services"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="RegisterWindow"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="1"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <materialDesign:Card
            Width="400"
            Padding="0"
            UniformCornerRadius="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <materialDesign:ColorZone
                    Height="50"
                    materialDesign:ElevationAssist.Elevation="Dp4"
                    Mode="PrimaryMid">
                    <Grid>
                        <DockPanel>
                            <TextBlock
                                Margin="20,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                                Text="Đặt lại mật khẩu và tên người dùng" />
                        </DockPanel>
                    </Grid>
                </materialDesign:ColorZone>
                <Grid Grid.Row="1" Margin="30,15,30,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="1" Margin="0,0,0,20">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            IsEnabled="{Binding IsEnable}"
                            Kind="Account" />
                        <TextBox
                            Padding="5,10"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.Hint="Tên đăng nhập"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            FontSize="14"
                            IsEnabled="{Binding IsEnable}"
                            Text="{Binding User.Name}"
                            TextWrapping="Wrap" />
                    </DockPanel>

                    <DockPanel Grid.Row="3" Margin="0,0,0,20">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Lock" />
                        <PasswordBox
                            Padding="5,10"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.Hint="Mật khẩu"
                            services:PasswordHelper.Attach="True"
                            services:PasswordHelper.BoundPassword="{Binding NewPassword, Mode=TwoWay}"
                            FontSize="14"
                            IsEnabled="{Binding IsEnable}"
                            Style="{StaticResource MaterialDesignFilledRevealPasswordBox}" />
                    </DockPanel>
                    <DockPanel Grid.Row="4" Margin="0,0,0,20">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Lock" />
                        <PasswordBox
                            Padding="5,10"
                            HorizontalAlignment="Stretch"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.Hint="Xác nhận mật khẩu"
                            services:PasswordHelper.Attach="True"
                            services:PasswordHelper.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}"
                            FontSize="14"
                            IsEnabled="{Binding IsEnable}"
                            Style="{StaticResource MaterialDesignFilledRevealPasswordBox}" />
                    </DockPanel>

                    <StackPanel
                        Grid.Row="5"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="UpdateCommand"
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="Xác nhận"
                            IsEnabled="{Binding IsEnable}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button
                            x:Name="Cancel"
                            Width="100"
                            Height="40"
                            Margin="5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            IsEnabled="{Binding IsEnable}"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Cancel" />
                                <TextBlock>Hủy</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
