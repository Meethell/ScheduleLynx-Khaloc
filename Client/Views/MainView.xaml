<Window
    x:Class="Client.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Name="mainWindow"
    Title="Fujimed Quản lý"
    Width="1280"
    Height="720"
    FontFamily="{DynamicResource MaterialDesignFont}"
    IsEnabled="{Binding IsEnable}"
    WindowStartupLocation="CenterScreen"
    WindowState="{Binding WindowState}"
    WindowStyle="{Binding WindowStyle}"
    mc:Ignorable="d">
    <Window.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Storyboard x:Key="MenuOpen">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridMenu" Storyboard.TargetProperty="(FrameworkElement.Width)">
                <EasingDoubleKeyFrame KeyTime="0" Value="65" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="200" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation
                Storyboard.TargetName="tbMenu"
                Storyboard.TargetProperty="Opacity"
                To="100"
                Duration="0:0:0.3" />
        </Storyboard>
        <Storyboard x:Key="MenuClose">
            <DoubleAnimation
                Storyboard.TargetName="tbMenu"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.1" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridMenu" Storyboard.TargetProperty="(FrameworkElement.Width)">
                <EasingDoubleKeyFrame KeyTime="0" Value="200" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="65" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="bnOpenMenu">
            <BeginStoryboard Storyboard="{StaticResource MenuOpen}" />
        </EventTrigger>
        <EventTrigger RoutedEvent="ButtonBase.Click" SourceName="bnCloseMenu">
            <BeginStoryboard Storyboard="{StaticResource MenuClose}" />
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <!--  Header Grid  -->
        <materialDesign:ColorZone
            Grid.Row="0"
            Grid.Column="1"
            Height="30"
            VerticalAlignment="Top"
            Mode="PrimaryDark">
            <DockPanel VerticalAlignment="Center">
                <StackPanel
                    Width="auto"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="White"
                        Text="Option" />
                    <materialDesign:PopupBox
                        Margin="5,0,10,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        PlacementMode="BottomAndAlignRightEdges"
                        StaysOpen="True">
                        <StackPanel Width="150">
                            <StackPanel Margin="0,10" Orientation="Horizontal">
                                <TextBlock
                                    Margin="15,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Toàn màn hình" />
                                <CheckBox
                                    Margin="5,0"
                                    HorizontalAlignment="Right"
                                    IsChecked="{Binding IsWindowFullScreen}" />
                            </StackPanel>
                            <!--  Đăng xuất  -->
                            <Button cal:Message.Attach="[Event Click] = [Action Logout]">
                                <TextBlock Foreground="Red" Text="Đăng xuất" />
                            </Button>
                            <Separator />
                            <Button
                                x:Name="bnExit"
                                cal:Message.Attach="[Event Click] = [Action bnExit]"
                                Content="Exit" />
                        </StackPanel>
                    </materialDesign:PopupBox>
                </StackPanel>

            </DockPanel>
        </materialDesign:ColorZone>
        <!--  Menu Grid  -->
        <Grid Grid.RowSpan="2">
            <materialDesign:ColorZone
                x:Name="GridMenu"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="0"
                Width="170"
                Height="{Binding ActualHeight, ElementName=mainWindow}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Mode="PrimaryMid">
                <!--  Tieu de pham mem  -->
                <StackPanel Grid.Column="0">
                    <Image VerticalAlignment="Center" Source="/Resources/ComName.jpg" />
                    <!--  menu grid  -->
                    <Grid Height="55">
                        <TextBlock
                            x:Name="tbMenu"
                            Margin="20,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                            Text="MENU" />
                        <!--  Open/Close menu button  -->
                        <Button
                            x:Name="bnCloseMenu"
                            Width="70"
                            Height="50"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Minimize Menu">
                            <materialDesign:PackIcon
                                Width="35"
                                Height="40"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="ArrowLeft" />
                        </Button>
                        <Button
                            x:Name="bnOpenMenu"
                            Width="60"
                            Height="50"
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            ToolTip="Expand Menu"
                            Visibility="Collapsed">
                            <materialDesign:PackIcon
                                Width="35"
                                Height="40"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="HamburgerMenu" />
                        </Button>
                    </Grid>
                    <!--  Menu Items  -->
                    <StackPanel HorizontalAlignment="Left" Orientation="Vertical">
                        <Separator Margin="0,4,0,10" />
