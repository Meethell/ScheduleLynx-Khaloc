                    </StackPanel>
                </StackPanel>
            </materialDesign:ColorZone>
        </Grid>
        <!--  Footer  -->
        <DockPanel
            x:Name="dpFooter"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2">
            <materialDesign:ColorZone Height="{Binding ActualHeight, ElementName=dpFooter}" Mode="PrimaryDark" />
        </DockPanel>
        <!--  Content Control  -->
        <ContentControl
            x:Name="ActiveItem"
            Grid.Row="1"
            Grid.Column="1" />
    </Grid>
</Window>
