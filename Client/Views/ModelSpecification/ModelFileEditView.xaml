<Window
    x:Class="Client.Views.ModelFileEditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="MessageBoxWindow"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="1"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  Đảm bảo Background không phải là Transparent  -->
    <Window.Resources>
        <Style TargetType="{x:Type Window}">
            <Setter Property="shell:WindowChrome.WindowChrome">
                <Setter.Value>
                    <shell:WindowChrome
                        CaptionHeight="0"
                        CornerRadius="10"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <GroupBox
        Width="450"
        Padding="15"
        Style="{StaticResource MaterialDesignCardGroupBox}">
        <GroupBox.Header>
            <TextBlock
                Margin="0,5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontWeight="Medium"
                Foreground="White"
                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                Text="SỬA THÔNG TIN FILE" />
        </GroupBox.Header>
        <ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.Row="0"
                    Grid.RowSpan="3"
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <materialDesign:PackIcon
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                        ToolTip="{Binding ModelFile.FileName}"
                        ToolTipService.InitialShowDelay="50">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="File" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="jpg">
                                        <Setter Property="Kind" Value="Image" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="pdf">
                                        <Setter Property="Kind" Value="FilePdfBox" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="docx">
                                        <Setter Property="Kind" Value="FileWord" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="xlsx">
                                        <Setter Property="Kind" Value="MicrosoftExcel" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="pptx">
                                        <Setter Property="Kind" Value="MicrosoftPowerpoint" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ModelFile.FileExtension}" Value="Other">
                                        <Setter Property="Kind" Value="File" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </StackPanel>
                <!--  Tên File  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                    Text="Tên File:" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="2"
                    MinWidth="200"
                    Margin="0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignTextBox}">
                    <!--  Validation  -->
                    <TextBox.Text>
                        <Binding Path="ModelFile.FileName" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <domain:NotEmptyValidationRule xmlns:domain="clr-namespace:Client.Domain" ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <!--  Phân loại  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                    Text="Phân loại:" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="200"
                    Margin="0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignTextBox}">
                    <!--  Validation  -->
                    <TextBox.Text>
                        <Binding Path="ModelFile.FileType" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <domain:NotEmptyValidationRule xmlns:domain="clr-namespace:Client.Domain" ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <!--  Mã File  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                    Text="Mã File:" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="2"
                    MinWidth="200"
                    Margin="0,10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignTextBox}">
                    <!--  Validation  -->
                    <TextBox.Text>
                        <Binding Path="ModelFile.FileCode" UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <domain:NotEmptyValidationRule xmlns:domain="clr-namespace:Client.Domain" ValidatesOnTargetUpdated="True" />
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <!--  Button  -->
                    <Button
                        x:Name="ButtonOk"
                        Width="75"
                        Margin="10"
                        VerticalAlignment="Top"
                        Content="Ok"
                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                    <Button
                        x:Name="ButtonCancel"
                        Width="75"
                        Margin="10"
                        VerticalAlignment="Top"
                        Content="Cancel" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </GroupBox>
</Window>