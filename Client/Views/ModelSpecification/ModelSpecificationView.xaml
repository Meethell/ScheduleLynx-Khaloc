<UserControl
    x:Class="Client.Views.ModelSpecificationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    d:DesignHeight="500"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
        <CollectionViewSource x:Key="GroupedModelSpecifications" Source="{Binding ModelSpecifications}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="ModelSpecificationGroup.Name" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <Grid>
        <materialDesign:Card
            Padding="20"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ScrollViewer
                        Grid.Row="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="{Binding IsHeaderRowVisible, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <StackPanel Orientation="Vertical">
                                    <Image
                                        MinWidth="100"
                                        MinHeight="150"
                                        MaxWidth="150"
                                        MaxHeight="150"
                                        Source="{Binding Model.Image}"
                                        Stretch="Uniform" />
                                    <Button
                                        x:Name="UploadImageCommand"
                                        Margin="0,5"
                                        Content="Tải lên ảnh" />
                                </StackPanel>
                                <StackPanel
                                    MinWidth="100"
                                    Margin="5,0"
                                    Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,5"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="{Binding Model.Manufacturer.Name}" />
                                        <TextBlock
                                            Margin="0,5"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text=" / " />
                                        <TextBlock
                                            Margin="0,5"
                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                            Text="{Binding Model.Manufacturer.Country.Name}" />
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,5"
                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                        Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                        Text="{Binding Model.Name}" />
                                    <TextBlock
                                        Margin="0,5"
                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                        Text="{Binding Model.TradeName}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBox
                                    Width="400"
                                    Height="180"
                                    MinWidth="200"
                                    Margin="5,10,5,5"
                                    materialDesign:HintAssist.FloatingScale="1.5"
                                    materialDesign:HintAssist.Hint="Mô tả"
                                    AcceptsReturn="True"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Text="{Binding Model.Descriptions}"
                                    TextAlignment="Justify"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />


                            </StackPanel>
                        </Grid>

                    </ScrollViewer>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <!--  Toggle Expand  -->
                            <Button
                                x:Name="GridExpand"
                                Width="22"
                                Height="22"
                                Margin="0,10"
                                Padding="5"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsHeaderRowVisible, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="ArrowExpand" />
                            </Button>
                            <Button
                                x:Name="GridCollapse"
                                Width="22"
                                Height="22"
                                Margin="0,10"
                                Padding="5"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Visibility="{Binding IsHeaderRowNotVisible, Converter={StaticResource BoolToVis}}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="ArrowCollapse" />
                            </Button>
                            <!--  View all  -->
                            <Button
                                x:Name="ToggleViewAllSpecification"
                                Height="75"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignFlatButton}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            Width="5"
                                            VerticalAlignment="Stretch"
                                            Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                                            Text="Xem tất cả"
                                            TextAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                            <Button
                                x:Name="ToggleSpecificationGroup"
                                Height="115"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Style="{StaticResource MaterialDesignFlatButton}">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            Width="5"
                                            VerticalAlignment="Stretch"
                                            Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                                            Text="Nhóm Tính năng"
                                            TextAlignment="Center">
                                            <TextBlock.LayoutTransform>
                                                <RotateTransform Angle="90" />
                                            </TextBlock.LayoutTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>

                        <!--  Bảng SpecificationGroup  -->
                        <Grid
                            Grid.Column="1"
                            VerticalAlignment="Stretch"
                            Visibility="{Binding IsSpecificationGroupColumnVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,10"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                FontSize="12"
                                IsEnabled="{Binding IsModelSpecificationGroupEnable}"
                                IsReadOnly="{Binding IsModelSpecificationGroupReadOnly}"
                                ItemsSource="{Binding ModelSpecificationGroups}"
                                SelectedItem="{Binding SelectedModelSpecificationGroup}"
                                SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            cal:Message.Attach="[Click] = [Action bnModelSpecificationGroupEdit()]"
                                            Header="Edit"
                                            Visibility="{Binding IsModelSpecificationGroupReadOnly, Converter={StaticResource BoolToVis}}" />
                                        <MenuItem
                                            cal:Message.Attach="[Click] = [Action bnModelSpecificationGroupDelete()]"
                                            Header="Delete"
                                            Visibility="{Binding IsModelSpecificationGroupDeleteButtonEnable}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Resources>
                                    <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="SortDirection" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <materialDesign:DataGridTextColumn Header="Nhóm tính năng">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="AcceptsReturn" Value="True" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                        <materialDesign:DataGridTextColumn.Binding>
                                            <Binding Path="Name" />
                                        </materialDesign:DataGridTextColumn.Binding>
                                    </materialDesign:DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!--  Buttons  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="bnModelSpecificationGroupNew"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnModelSpecificationGroupNew()]"
                                    Content="Tạo mới"
                                    IsEnabled="{Binding IsModelSpecificationGroupNewButtonEnable}" />
                                <Button
                                    x:Name="bnModelSpecificationGroupEdit"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnModelSpecificationGroupEdit()]"
                                    Content="Sửa"
                                    IsEnabled="{Binding IsModelSpecificationGroupEditButtonEnable}"
                                    Visibility="{Binding IsModelSpecificationGroupReadOnly, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    x:Name="bnModelSpecificationGroupSave"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnModelSpecificationGroupOk()]"
                                    Content="Lưu"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding IsModelSpecificationGroupUserEditting, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    x:Name="bnModelSpecificationGroupCancel"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnModelSpecificationGroupCancel()]"
                                    Content="Hủy"
                                    Visibility="{Binding IsModelSpecificationGroupUserEditting, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <!--  Grid Splitter  -->
                            <GridSplitter
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Width="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                ResizeBehavior="PreviousAndCurrent" />
                        </Grid>
                        <!--  Bảng Specificaton  -->
                        <Grid Grid.Column="3" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <!--  Filter Search textbox  -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <ComboBox
                                    Width="150"
                                    Height="auto"
                                    Margin="0,10,0,0"
                                    materialDesign:HintAssist.Hint="Tìm kiếm theo"
                                    FontSize="14"
                                    ItemsSource="{Binding SpecificationFilter}"
                                    SelectedItem="{Binding SelectedSpecificationFilter}"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                                <TextBox
                                    MinWidth="300"
                                    Margin="10,10,0,0"
                                    materialDesign:HintAssist.Hint="Tìm kiếm"
                                    materialDesign:TextFieldAssist.HasClearButton="True"
                                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                    materialDesign:TextFieldAssist.LeadingIcon="Search"
                                    materialDesign:TextFieldAssist.LeadingIconSize="20"
                                    FontSize="14"
                                    Text="{Binding SpecificationSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <DataGrid
                                Grid.Row="1"
                                Margin="0,10,0,10"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                FontSize="12"
                                IsEnabled="{Binding IsSpecificationEnable}"
                                IsReadOnly="{Binding IsSpecificationReadOnly}"
                                ItemsSource="{Binding Source={StaticResource GroupedModelSpecifications}}"
                                SelectedItem="{Binding SelectedSpecification}"
                                SelectionMode="Single">
                                <DataGrid.ContextMenu>
                                    <ContextMenu MinWidth="200">
                                        <MenuItem
                                            cal:Message.Attach="[Click] = [Action OnGroupSelected($eventArgs)]"
                                            Header="Move Item to Group"
                                            ItemsSource="{Binding ModelSpecificationGroups}">
                                            <MenuItem.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </MenuItem.ItemTemplate>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem
                                            cal:Message.Attach="[Click] = [Action bnSpecificationEdit()]"
                                            Header="Edit"
                                            Visibility="{Binding IsSpecificationReadOnly, Converter={StaticResource BoolToVis}}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="Pencil" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            cal:Message.Attach="[Click] = [Action bnSpecificationDelete()]"
                                            Header="Delete"
                                            Visibility="{Binding IsSpecificationDeleteButtonEnable}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="Delete" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Resources>
                                    <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                        <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Style.Triggers>
                                            <Trigger Property="SortDirection" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.ContainerStyle>
                                            <Style TargetType="{x:Type GroupItem}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                                            <Expander IsExpanded="True">
                                                                <Expander.Header>
                                                                    <DockPanel>
                                                                        <!--  Thêm Specification  -->
                                                                        <TextBlock
                                                                            VerticalAlignment="Center"
                                                                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                                                            Text="{Binding Name}" />
                                                                    </DockPanel>
                                                                </Expander.Header>
                                                                <ItemsPresenter />
                                                            </Expander>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GroupStyle.ContainerStyle>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <!--  Tính năng kỹ thuật  -->
                                    <materialDesign:DataGridTextColumn
                                        MinWidth="100"
                                        MaxWidth="300"
                                        Header="Tính năng kỹ thuật">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="AcceptsReturn" Value="True" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                        <materialDesign:DataGridTextColumn.Binding>
                                            <Binding Path="Specification" />
                                        </materialDesign:DataGridTextColumn.Binding>
                                    </materialDesign:DataGridTextColumn>
                                    <!--  Trích dẫn  -->
                                    <materialDesign:DataGridTextColumn
                                        MinWidth="100"
                                        MaxWidth="300"
                                        Header="Trích dẫn">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="AcceptsReturn" Value="True" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                        <materialDesign:DataGridTextColumn.Binding>
                                            <Binding Path="QuoteLine" />
                                        </materialDesign:DataGridTextColumn.Binding>
                                    </materialDesign:DataGridTextColumn>
                                    <!--  Trang tham khảo  -->
                                    <materialDesign:DataGridTextColumn
                                        MinWidth="100"
                                        MaxWidth="300"
                                        Header="Trang tham khảo">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="AcceptsReturn" Value="True" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                        <materialDesign:DataGridTextColumn.Binding>
                                            <Binding Path="ReferenceLine" />
                                        </materialDesign:DataGridTextColumn.Binding>
                                    </materialDesign:DataGridTextColumn>
                                    <!--  File tham khảo  -->
                                    <materialDesign:DataGridComboBoxColumn
                                        Width="150"
                                        MinWidth="100"
                                        CanUserSort="True"
                                        DisplayMemberPath="FileName"
                                        Header="File tham khảo"
                                        ItemsSourceBinding="{Binding DataContext.ModelFiles, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedItemBinding="{Binding ModelFile}">
                                        <materialDesign:DataGridComboBoxColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type ComboBox}, ResourceId=MaterialDataGridComboBoxColumnEditingStyle}}" TargetType="ComboBox">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </materialDesign:DataGridComboBoxColumn.ElementStyle>
                                        <materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource {ComponentResourceKey TypeInTargetAssembly={x:Type ComboBox}, ResourceId=MaterialDataGridComboBoxColumnEditingStyle}}" TargetType="ComboBox">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </materialDesign:DataGridComboBoxColumn.EditingElementStyle>
                                    </materialDesign:DataGridComboBoxColumn>
                                    <!--  Tính năng chính  -->
                                    <DataGridCheckBoxColumn Binding="{Binding IsKeySpecification}" Header="Tính năng chính" />
                                    <!--  Ghi chú  -->
                                    <materialDesign:DataGridTextColumn
                                        MinWidth="100"
                                        MaxWidth="250"
                                        CanUserSort="True"
                                        Header="Ghi chú">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.EditingElementStyle>
                                            <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="AcceptsReturn" Value="True" />
                                            </Style>
                                        </DataGridTextColumn.EditingElementStyle>
                                        <materialDesign:DataGridTextColumn.Binding>
                                            <Binding Path="Notes" />
                                        </materialDesign:DataGridTextColumn.Binding>
                                    </materialDesign:DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!--  Buttons  -->
                            <StackPanel
                                Grid.Row="2"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="bnSpecificationNew"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnSpecificationNew()]"
                                    Content="Tạo mới"
                                    IsEnabled="{Binding IsSpecificationNewButtonEnable}" />
                                <Button
                                    x:Name="bnSpecificationEdit"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnSpecificationEdit()]"
                                    Content="Sửa"
                                    IsEnabled="{Binding IsSpecificationEditButtonEnable}"
                                    Visibility="{Binding IsSpecificationReadOnly, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    x:Name="bnSpecificationSave"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnSpecificationOK()]"
                                    Content="Lưu"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Visibility="{Binding IsSpecificationUserEditting, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    x:Name="bnSpecificationCancel"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnSpecificationCancel()]"
                                    Content="Hủy"
                                    Visibility="{Binding IsSpecificationUserEditting, Converter={StaticResource BoolToVis}}" />
                                <Button
                                    x:Name="bnSpecificationDelete"
                                    Width="75"
                                    Margin="10"
                                    VerticalAlignment="Top"
                                    cal:Message.Attach="[Event Click] = [Action bnSpecificationDelete()]"
                                    Content="Xóa"
                                    IsEnabled="{Binding IsSpecificationDeleteButtonEnable}" />
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>
                <Grid Grid.Column="1" Visibility="{Binding IsSecondColumnVisible, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <GridSplitter
                        Grid.Column="0"
                        Width="5"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        ResizeBehavior="CurrentAndNext" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="5,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Orientation="Vertical">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="TẢI LÊN FILE" />
                            <!--  Upload Button  -->
                            <Button
                                Width="auto"
                                Height="auto"
                                Margin="5"
                                Padding="5,0"
                                HorizontalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action UploadFile()]"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                Visibility="{Binding IsUploadVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Upload" />
                                </StackPanel>
                            </Button>
                            <!--  Mở thư mục chứa File  -->
                            <Button
                                Width="auto"
                                Height="auto"
                                Margin="5"
                                Padding="5,0"
                                HorizontalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action OpenFolder()]"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}"
                                Visibility="{Binding IsUploadVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Folder" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <DataGrid
                            cal:Message.Attach="[MouseDoubleClick] = [Action OpenFile()]"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            ItemsSource="{Binding ModelFiles}"
                            SelectedItem="{Binding SelectedModelFile}">
                            <DataGrid.Resources>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Height" Value="0" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="200"
                                                HorizontalAlignment="Stretch"
                                                ToolTip="{Binding FileName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="0"
                                                    Width="50"
                                                    Height="50"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    ToolTip="{Binding ModelFile.FileName}"
                                                    ToolTipService.InitialShowDelay="50">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Kind" Value="File" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="jpg">
                                                                    <Setter Property="Kind" Value="Image" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="pdf">
                                                                    <Setter Property="Kind" Value="FilePdfBox" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="docx">
                                                                    <Setter Property="Kind" Value="FileWord" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="xlsx">
                                                                    <Setter Property="Kind" Value="MicrosoftExcel" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="pptx">
                                                                    <Setter Property="Kind" Value="MicrosoftPowerpoint" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FileExtension}" Value="Other">
                                                                    <Setter Property="Kind" Value="File" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <TextBlock
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Bottom"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding FileName}" />
                                                <TextBlock
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Margin="0,0,10,0"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource MaterialDesignOverlineTextBlock}"
                                                    Text="{Binding FileType}" />

                                                <Button
                                                    x:Name="ViewFile"
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Margin="0,2"
                                                    Padding="5,0"
                                                    cal:Message.Attach="[Event Click] = [Action ViewFile()]"
                                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}">
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Kind="Pencil" />
                                                </Button>
                                                <Button
                                                    x:Name="DeleteFile"
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Margin="0,2"
                                                    Padding="5,0"
                                                    cal:Message.Attach="[Event Click] = [Action DeleteFile()]"
                                                    Style="{StaticResource MaterialDesignOutlinedDarkButton}">
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        VerticalAlignment="Center"
                                                        Kind="Delete" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>


                <Button
                    x:Name="ToggleUploadFile"
                    Grid.Column="2"
                    Height="95"
                    Padding="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Uploaded File"
                                TextAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                            <Rectangle
                                Width="5"
                                VerticalAlignment="Stretch"
                                Fill="{DynamicResource MaterialDesign.Brush.Primary}" />
                        </StackPanel>

                    </Button.Content>
                </Button>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
