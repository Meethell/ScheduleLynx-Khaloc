<UserControl
    x:Class="Client.Views.SparePartManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    d:DesignHeight="450"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  Model Selector  -->
        <Grid Grid.Column="1" Visibility="{Binding IsModelSelectorVisible, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" materialDesign:ElevationAssist.Elevation="Dp5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Manufacturer Selector  -->
                <GroupBox
                    Grid.Column="0"
                    Margin="0,0,5,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    materialDesign:GroupBoxAssist.HeaderPadding="5"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.Header>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                Foreground="White"
                                Kind="Factory" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="Nhà sản xuất" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!--  Search Box  -->
                        <!--  Search TextBox  -->
                        <TextBox
                            Width="200"
                            Height="auto"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-20"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Tìm kiếm"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Search"
                            materialDesign:TextFieldAssist.LeadingIconSize="20"
                            FontSize="14"
                            IsEnabled="{Binding IsManufacturerEnable}"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding SearchManufacturer, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  Manufacturer List  -->
                        <ListBox
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{Binding IsManufacturerEnable}"
                            ItemsSource="{Binding Manufacturers}"
                            SelectedItem="{Binding SelectedManufacturer}"
                            SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        x:Name="Border"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1">
                                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                HorizontalAlignment="Stretch"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Country.Name}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>
                <!--  Model Selector  -->
                <GroupBox
                    Grid.Column="1"
                    Margin="0,0,5,0"
                    Padding="10"
                    materialDesign:ElevationAssist.Elevation="Dp6"
                    materialDesign:GroupBoxAssist.HeaderPadding="5"
                    Style="{StaticResource MaterialDesignCardGroupBox}">
                    <GroupBox.Header>
                        <StackPanel
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                Margin="0,0,5,0"
                                Foreground="White"
                                Kind="WrenchCog" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Foreground="White"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="Danh Sách Phụ Tùng" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <!--  Search/filter row  -->
                        <StackPanel Margin="0" Orientation="Horizontal">
                            <!--  Filter ComboBox  -->
                            <ComboBox
                                Width="130"
                                Height="auto"
                                Margin="10,11,10,0"
                                VerticalAlignment="Center"
                                materialDesign:HintAssist.Hint="Tìm kiếm theo"
                                ItemsSource="{Binding Filters}"
                                SelectedItem="{Binding SelectedFilter}" />
                            <!--  Search TextBox  -->
                            <TextBox
                                x:Name="SearchText"
                                Width="200"
                                Height="auto"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                materialDesign:HintAssist.FloatingOffset="0,-20"
                                materialDesign:HintAssist.FloatingScale="1.15"
                                materialDesign:HintAssist.Hint="Tìm kiếm"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="Search"
                                materialDesign:TextFieldAssist.LeadingIconSize="20"
                                FontSize="14"
                                IsEnabled="{Binding IsSearchTextEnable}"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <!--  Spare Part List  -->
                        <DataGrid
                            Grid.Row="1"
                            Margin="0,10,0,10"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsEnabled="{Binding IsSparePartEnable}"
                            IsReadOnly="{Binding IsSparePartReadOnly}"
                            ItemsSource="{Binding SpareParts}"
                            SelectedItem="{Binding SelectedSparePart}"
                            SelectionMode="Single">
                            <DataGrid.Resources>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontSize" Value="14" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!--  SpareParts Name  -->
                                <materialDesign:DataGridTextColumn
                                    MinWidth="150"
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    EditingElementStyle="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}"
                                    Header="Tên Phụ tùng">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="Name" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  SpareParts Number  -->
                                <materialDesign:DataGridTextColumn
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    Header="Mã Phụ tùng">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="PartNumber" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  SpareParts Number  -->
                                <materialDesign:DataGridTextColumn
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    Header="Số lượng lưu kho">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="QuantityInStock" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                                <!--  SpareParts DesCription  -->
                                <materialDesign:DataGridTextColumn
                                    MaxWidth="250"
                                    CanUserSort="True"
                                    Header="Ghi chú">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.EditingElementStyle>
                                        <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnEditingStyle}" TargetType="{x:Type TextBox}">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="AcceptsReturn" Value="True" />
                                        </Style>
                                    </DataGridTextColumn.EditingElementStyle>
                                    <materialDesign:DataGridTextColumn.Binding>
                                        <Binding Path="Description" />
                                    </materialDesign:DataGridTextColumn.Binding>
                                </materialDesign:DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!--  Buttons  -->
                        <StackPanel
                            Grid.Row="2"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                            <Button
                                x:Name="bnSparePartNew"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Thêm mới"
                                IsEnabled="{Binding IsSparePartNewButtonEnable}" />
                            <Button
                                x:Name="bnSparePartEdit"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Sửa"
                                IsEnabled="{Binding IsSparePartEditButtonEnable}"
                                Visibility="{Binding IsSparePartReadOnly, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnSparePartSave"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Lưu"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Visibility="{Binding IsSparePartUserEditting, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnSparePartCancel"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Hủy"
                                Visibility="{Binding IsSparePartUserEditting, Converter={StaticResource BoolToVis}}" />
                            <Button
                                x:Name="bnSparePartDelete"
                                Width="75"
                                Margin="10"
                                VerticalAlignment="Top"
                                Content="Xóa"
                                IsEnabled="{Binding IsSparePartDeleteButtonEnable}" />
                        </StackPanel>

                    </Grid>
                </GroupBox>
            </Grid>


            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                ResizeBehavior="PreviousAndCurrent" />
        </Grid>
        <!--  Ticket  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox
                Grid.Row="0"
                Margin="0,0,0,10"
                Padding="10"
                materialDesign:ElevationAssist.Elevation="Dp6"
                materialDesign:GroupBoxAssist.HeaderPadding="5"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.Header>
                    <StackPanel
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            Foreground="White"
                            Kind="Warehouse" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="Thống Kê Số lượng" />
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <!--  Fist Date  -->
                        <DatePicker
                            Width="150"
                            Margin="5,0"
                            SelectedDate="{Binding DateFrom}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        <!--  Last Date  -->
                        <DatePicker
                            Width="150"
                            Margin="5,0"
                            SelectedDate="{Binding DateTo}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" />
                        <!--  Button Query  -->
                        <Button
                            Margin="5,0"
                            Padding="10,0"
                            cal:Message.Attach="[Event Click] = [Action QuerySparePartStatistics()]"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="Magnify" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!--  Hiển thị số lượng xuất kho trong thời gian  -->
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,10"
                        Style="{StaticResource MaterialDesignBody1TextBlock}">
                        <Run FontWeight="Medium" Text="Số lượng xuất kho: " />
                        <Run Text="{Binding OutNumber}" />
                    </TextBlock>

                </Grid>

            </GroupBox>

            <GroupBox
                Grid.Row="1"
                Margin="0,0,0,0"
                Padding="10"
                materialDesign:ElevationAssist.Elevation="Dp6"
                materialDesign:GroupBoxAssist.HeaderPadding="5"
                Style="{StaticResource MaterialDesignCardGroupBox}">
                <GroupBox.Header>
                    <StackPanel
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            Foreground="White"
                            Kind="Ticket" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="Thẻ Liên Quan" />
                    </StackPanel>
                </GroupBox.Header>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ShowTickets}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <materialDesign:Card
                                    Padding="10"
                                    HorizontalAlignment="Stretch"
                                    materialDesign:ElevationAssist.Elevation="Dp5"
                                    BorderThickness="2"
                                    UniformCornerRadius="5">
                                    <StackPanel
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        Orientation="Vertical">
                                        <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="Ticket" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="Số thẻ: " />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Ticket.TicketNumber}" />
                                            <TextBlock
                                                Margin="5,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="-" />
                                            <TextBlock
                                                Margin="5,0"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="{Binding Ticket.Title}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="1"
                                                Width="auto"
                                                Height="auto"
                                                Padding="5"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                                                Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Kind="Search" />
                                                </StackPanel>
                                            </Button>
                                        </DockPanel>
                                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto" />
                                                <ColumnDefinition Width="auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                                <RowDefinition Height="auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Status  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="ListStatus" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Trạng thái: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.Status.Status}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Ticket.Status.Color}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Priority  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="PriorityHigh" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Mức độ ưu tiên: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.Priority.Name}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Ticket.Priority.Color}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Orientation="Horizontal">
                                                <!--  Ticket Type  -->
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Sort" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Loại Ticket: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.Type.Type}" />
                                                <!--  Circle Color indicator  -->
                                                <Ellipse
                                                    Width="10"
                                                    Height="10"
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{Binding Ticket.Type.Color}" />
                                            </StackPanel>
                                            <!--  Created Date  -->
                                            <StackPanel
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày tạo: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <!--  OverDue Date  -->
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày đến hạn: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{Binding Ticket.Overdue, Converter={StaticResource BoolToColorConverter}}"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.DateDue, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                Orientation="Horizontal">
                                                <!--  Updated Date  -->
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="30,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Calendar" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="Ngày cập nhật: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                    Text="{Binding Ticket.DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                                            </StackPanel>
                                        </Grid>
                                        <Separator
                                            Height="1"
                                            Margin="0,10,0,10"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                Kind="CogBox" />
                                            <TextBlock
                                                Margin="5,0,0,0"
                                                VerticalAlignment="Center"
                                                FontWeight="Medium"
                                                Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                Text="Phụ tùng thay thế" />
                                        </StackPanel>
                                        <!--  List View  -->
                                        <ListView
                                            MaxHeight="300"
                                            ItemsSource="{Binding TicketSpareParts}"
                                            SelectedItem="{Binding SelectedTicketSparePart}">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn DisplayMemberBinding="{Binding SparePart.Name}" Header="Tên phụ tùng" />
                                                    <GridViewColumn DisplayMemberBinding="{Binding SparePart.PartNumber}" Header="Mã phụ tùng" />
                                                    <GridViewColumn DisplayMemberBinding="{Binding SerialNumber}" Header="Số Seri" />
                                                    <GridViewColumn DisplayMemberBinding="{Binding Quantity}" Header="Số lượng" />
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </StackPanel>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>