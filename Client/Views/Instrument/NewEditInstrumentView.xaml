<UserControl
    x:Class="Client.Views.NewEditInstrumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <Grid>
        <materialDesign:Card
            Margin="10"
            Padding="8"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">

            <ScrollViewer>
                <StackPanel
                    x:Name="MainStackPanel"
                    Margin="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
                    <DockPanel>
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <TextBox
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="0"
                                Height="45"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                materialDesign:HintAssist.FloatingOffset="0,-30"
                                materialDesign:HintAssist.FloatingScale="1.15"
                                materialDesign:HintAssist.Hint="Tên thiết bị"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                materialDesign:TextFieldAssist.LeadingIcon="TextBox"
                                materialDesign:TextFieldAssist.LeadingIconSize="20"
                                FontSize="14"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Text="{Binding Instrument.Name}" />
                            <!--  Due Day  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <DatePicker
                                    Height="40"
                                    MinWidth="150"
                                    Margin="0,10"
                                    Padding="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.FloatingOffset="0,-25"
                                    materialDesign:HintAssist.FloatingScale="1.15"
                                    materialDesign:HintAssist.Hint="Ngày Lắp đặt"
                                    materialDesign:HintAssist.IsFloating="True"
                                    FontSize="14"
                                    SelectedDate="{Binding Instrument.InstallDate, StringFormat={}{0:dd/MM/yyyy}}"
                                    Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                            </StackPanel>
                            <!--  Status  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="Regular"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Tình trạng: " />
                            <ComboBox
                                Grid.Row="2"
                                Grid.Column="2"
                                MinWidth="80"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Left"
                                DisplayMemberPath="Status"
                                FontSize="14"
                                FontWeight="Regular"
                                ItemsSource="{Binding InstrumentStatuses}"
                                SelectedItem="{Binding Instrument.Status}"
                                Style="{StaticResource MaterialDesignComboBox}" />
                            <!--  Circle Color indicator  -->
                            <Ellipse
                                Grid.Row="2"
                                Grid.Column="3"
                                Width="15"
                                Height="15"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="{Binding Instrument.Status.Color}" />
                        </Grid>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal">
                        <!--  InstrumnetType cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Devices" />
                        <ComboBox
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-30"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Loại Thiết bị"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Type"
                            FontSize="14"
                            ItemsSource="{Binding ModelTypes}"
                            SelectedItem="{Binding SelectedInstrumentType}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                        <!--  TicketPriority cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="20,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="HashtagBox" />
                        <TextBox
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-30"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Số Seri"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            FontSize="14"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding Instrument.SerialNumber}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  Manufacturer cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Factory" />
                        <ComboBox
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-30"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Nhà sản xuất"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            ItemsSource="{Binding Manufacturers}"
                            SelectedItem="{Binding SelectedManufacturer}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                        <!--  Model cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="20,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Devices" />
                        <ComboBox
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-30"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Model"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            IsEnabled="{Binding IsCbModelEnable}"
                            ItemsSource="{Binding Models}"
                            SelectedItem="{Binding Instrument.Model}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <!--  Customer cb  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,15"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Account" />
                        <ComboBox
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            HorizontalAlignment="Left"
                            materialDesign:HintAssist.FloatingOffset="0,-30"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Khách hàng"
                            materialDesign:HintAssist.IsFloating="True"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            IsEditable="True"
                            ItemsSource="{Binding Customers}"
                            SelectedItem="{Binding SelectedCustomer}"
                            Style="{StaticResource MaterialDesignFloatingHintComboBox}"
                            Text="{Binding CustomerSearchText}" />
                    </StackPanel>
                    <TextBox
                        Grid.Row="0"
                        Grid.RowSpan="3"
                        Grid.Column="0"
                        Height="45"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.FloatingOffset="0,-20"
                        materialDesign:HintAssist.FloatingScale="1.15"
                        materialDesign:HintAssist.Hint="Địa chỉ lắp đặt"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Location"
                        materialDesign:TextFieldAssist.LeadingIconSize="20"
                        FontSize="14"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding Instrument.Location}" />
                    <StackPanel Orientation="Horizontal">
                        <!--  LastPm Date  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="Calendar" />
                        <DatePicker
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            Padding="0,25,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Lần cuối bảo trì"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            SelectedDate="{Binding Instrument.LastPmDate, StringFormat={}{0:dd/MM/yyyy}}"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                        <!--  Due Day  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="20,0,5,20"
                            VerticalAlignment="Bottom"
                            Foreground="#707070"
                            Kind="CalendarAlert" />
                        <DatePicker
                            Width="300"
                            Height="45"
                            Margin="0,10"
                            Padding="0,25,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-25"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Lần bảo trì tiếp theo"
                            materialDesign:HintAssist.IsFloating="True"
                            FontSize="14"
                            SelectedDate="{Binding Instrument.NextPmDate, StringFormat={}{0:dd/MM/yyyy}}"
                            Style="{StaticResource MaterialDesignFloatingHintDatePicker}" />
                    </StackPanel>
                    <!--  Description tb  -->
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Foreground="#707070"
                            Kind="TextBox" />
                        <TextBlock
                            Margin="5,0,5,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Regular"
                            Foreground="#707070"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Mô tả" />
                    </StackPanel>
                    <TextBox
                        Width="{Binding ActualWidth, ElementName=MainStackPanel}"
                        MinHeight="150"
                        MaxHeight="300"
                        Margin="0,5,0,10"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        AcceptsReturn="True"
                        FontSize="14"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Instrument.Description}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />

                    <!--  Buttons  -->
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="btCancel"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignFlatButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Cancel" />
                                <TextBlock>Hủy</TextBlock>
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="btSave"
                            Width="100"
                            Height="40"
                            Margin="0,20,10,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSave" />
                                <TextBlock>Lưu</TextBlock>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
    </Grid>
</UserControl>