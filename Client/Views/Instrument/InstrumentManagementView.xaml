<UserControl
    x:Class="Client.Views.InstrumentManagementView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>
        <materialDesign:Card
            Margin="10,0,10,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  INSTRUMENT TITLE  -->
                <DockPanel HorizontalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Devices" />
                        <TextBlock
                            Margin="10"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                            Text="QUẢN LÝ THIẾT BỊ" />
                    </StackPanel>
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  Filter ComboBox  -->
                        <ComboBox
                            Width="130"
                            Height="auto"
                            Margin="10,11,10,0"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="Tìm kiếm theo"
                            ItemsSource="{Binding Filters}"
                            SelectedItem="{Binding SelectedFilter}" />
                        <!--  Search TextBox  -->
                        <TextBox
                            x:Name="SearchText"
                            Width="200"
                            Height="auto"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.FloatingOffset="0,-20"
                            materialDesign:HintAssist.FloatingScale="1.15"
                            materialDesign:HintAssist.Hint="Tìm kiếm"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            materialDesign:TextFieldAssist.HasLeadingIcon="True"
                            materialDesign:TextFieldAssist.LeadingIcon="Search"
                            materialDesign:TextFieldAssist.LeadingIconSize="20"
                            FontSize="14"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <!--  New Button  -->
                        <Button
                            x:Name="btNew"
                            Width="50"
                            Height="30"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Right"
                            cal:Message.Attach="[Event Click] = [Action btNew()]"
                            materialDesign:ButtonAssist.CornerRadius="5"
                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                            Visibility="{Binding IsNewButtonVisible, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Plus" />
                        </Button>
                    </StackPanel>
                </DockPanel>
                <!--  Seperator  -->
                <Separator Grid.Row="1" Margin="0,10" />
                <DataGrid
                    Grid.Row="2"
                    Margin="0,0,0,10"
                    cal:Message.Attach="[Event SelectionChanged] = [Action OpenInstrumentDetailViewCommand()]"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="12"
                    IsEnabled="True"
                    IsReadOnly="True"
                    ItemsSource="{Binding Instruments}"
                    SelectedItem="{Binding SelectedInstrument}"
                    SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!--  Instrument Name  -->
                        <DataGridTemplateColumn
                            MinWidth="150"
                            MaxWidth="300"
                            CanUserSort="True"
                            Header="Tên thiết bị">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                                        <TextBlock
                                            FontWeight="Medium"
                                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                                            Text="{Binding Name}"
                                            TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Location, StringFormat='Địa chỉ lắp đặt: {0}'}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!--  Model  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Model">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Model.Name" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Serial Number  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Số Seri">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="SerialNumber" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Customer  -->
                        <materialDesign:DataGridTextColumn
                            Width="200"
                            MinWidth="150"
                            MaxWidth="300"
                            CanUserSort="True"
                            Header="Khách hàng">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="Customer.Name" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Ngày lắp đặt  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Ngày lắp đặt">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="InstallDate" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Last PM date  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Bảo trì gần nhất">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="LastPmDate" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  Next PM date  -->
                        <materialDesign:DataGridTextColumn CanUserSort="True" Header="Bảo trì lần tới">
                            <DataGridTextColumn.ElementStyle>
                                <Style BasedOn="{StaticResource MaterialDesignDataGridTextColumnStyle}" TargetType="{x:Type TextBlock}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <materialDesign:DataGridTextColumn.Binding>
                                <Binding Path="NextPmDate" StringFormat="dd/MM/yyyy" />
                            </materialDesign:DataGridTextColumn.Binding>
                        </materialDesign:DataGridTextColumn>
                        <!--  InstrumentStatus  -->
                        <DataGridTemplateColumn Header="Tình trạng">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            Fill="{Binding Status.Color}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="{Binding Status.Status}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
