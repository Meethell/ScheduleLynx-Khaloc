<UserControl
    x:Class="Client.Views.InstrumentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="auto"
    Height="auto"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontFamily="{DynamicResource MaterialDesignFont}"
    FontSize="14"
    mc:Ignorable="d">

    <!--  BoolToVis  -->
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid>

        <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <!--  Navigation Button  -->
                    <RadioButton
                        x:Name="InstrumentManagementView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Quản lý thiết bị"
                        IsChecked="{Binding IsInstrumentManagementViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                    <RadioButton
                        x:Name="InstrumentModelView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Quản lý Model thiết bị"
                        IsChecked="{Binding IsInstrumentModelViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                    <RadioButton
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Thông tin thiết bị"
                        IsChecked="{Binding IsInstrumentDetailChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Visibility="{Binding IsInstrumnetDetailVisible, Converter={StaticResource BoolToVis}}" />
                    <RadioButton
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="{Binding NewEditTabTitle}"
                        IsChecked="{Binding IsNewEditInstrumentViewChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}"
                        Visibility="{Binding IsNewEditInstrumentVisible, Converter={StaticResource BoolToVis}}" />
                    <RadioButton
                        x:Name="SparePartManagementView"
                        Height="30"
                        BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
                        Content="Quản lý phụ tùng"
                        IsChecked="{Binding IsSparePartManagementChecked}"
                        Style="{StaticResource MaterialDesignTabRadioButton}" />
                </StackPanel>

                <ContentControl
                    x:Name="ActiveItem"
                    Grid.Row="1"
                    Margin="0,5,0,0" />
            </Grid>

        </materialDesign:Card>

    </Grid>
</UserControl>
