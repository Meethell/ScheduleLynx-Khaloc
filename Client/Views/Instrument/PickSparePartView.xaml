<Window
    x:Class="Client.Views.PickSparePartView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:Client.Services"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="RegisterWindow"
    AllowsTransparency="True"
    Background="Transparent"
    BorderThickness="1"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="WidthAndHeight"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    WindowStyle="None"
    mc:Ignorable="d">
    <materialDesign:Card
        Width="auto"
        Padding="0"
        UniformCornerRadius="15">
        <StackPanel>
            <materialDesign:ColorZone
                Height="50"
                materialDesign:ElevationAssist.Elevation="Dp4"
                Mode="PrimaryMid">
                <Grid>
                    <DockPanel>
                        <TextBlock
                            Margin="20,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignTitleMediumTextBlock}"
                            Text="Thêm phụ tùng thay thế" />
                    </DockPanel>
                </Grid>
            </materialDesign:ColorZone>
            <!--  Manufacturer ComboBox  -->
            <StackPanel Margin="10" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="Factory" />
                <TextBlock
                    Margin="5"
                    FontWeight="Medium"
                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                    Text="NHÀ SẢN XUẤT" />
            </StackPanel>
            <ComboBox
                MinWidth="250"
                Margin="10,0"
                materialDesign:HintAssist.Hint="Chọn nhà sản xuất"
                DisplayMemberPath="Name"
                IsEditable="True"
                ItemsSource="{Binding Manufacturers}"
                SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}" />

            <!--  Chọn phụ tùng  -->
            <StackPanel Margin="10" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="WrenchCog" />
                <TextBlock
                    Margin="5"
                    FontWeight="Medium"
                    Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                    Text="CHỌN PHỤ TÙNG" />
            </StackPanel>
            <!--  Search/filter row  -->
            <StackPanel Margin="0" Orientation="Horizontal">
                <!--  Filter ComboBox  -->
                <ComboBox
                    Width="130"
                    Height="auto"
                    Margin="10,11,10,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="Tìm kiếm theo"
                    ItemsSource="{Binding Filters}"
                    SelectedItem="{Binding SelectedFilter}" />
                <!--  Search TextBox  -->
                <TextBox
                    x:Name="SearchText"
                    Width="200"
                    Height="auto"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.FloatingOffset="0,-20"
                    materialDesign:HintAssist.FloatingScale="1.15"
                    materialDesign:HintAssist.Hint="Tìm kiếm"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    materialDesign:TextFieldAssist.HasLeadingIcon="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Search"
                    materialDesign:TextFieldAssist.LeadingIconSize="20"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <!--  ListView of SpareParts  -->
            <ListView
                Height="250"
                Margin="10,0"
                ItemsSource="{Binding SpareParts}"
                SelectedItem="{Binding SelectedSparePart, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn
                            Width="auto"
                            DisplayMemberBinding="{Binding Name}"
                            Header="Tên phụ tùng" />
                        <GridViewColumn
                            Width="auto"
                            DisplayMemberBinding="{Binding PartNumber}"
                            Header="Mã phụ tùng" />
                        <GridViewColumn
                            Width="auto"
                            DisplayMemberBinding="{Binding QuantityInStock}"
                            Header="Tồn kho"
                            TextBlock.TextAlignment="Center" />
                        <GridViewColumn
                            Width="auto"
                            DisplayMemberBinding="{Binding Description}"
                            Header="Mô tả" />

                    </GridView>
                </ListView.View>
            </ListView>
            <!--  Chọn số lượng  -->
            <TextBox
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Height="45"
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                materialDesign:HintAssist.FloatingOffset="0,-20"
                materialDesign:HintAssist.FloatingScale="1.15"
                materialDesign:HintAssist.Hint="Chọn số lượng"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Numbers"
                materialDesign:TextFieldAssist.LeadingIconSize="20"
                FontSize="14"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                Text="{Binding Quantity}" />
            <!--  Số seri  -->
            <TextBox
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Height="45"
                Margin="10,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                materialDesign:HintAssist.FloatingOffset="0,-20"
                materialDesign:HintAssist.FloatingScale="1.15"
                materialDesign:HintAssist.Hint="Số seri (nếu có)"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasLeadingIcon="True"
                materialDesign:TextFieldAssist.LeadingIcon="Barcode"
                materialDesign:TextFieldAssist.LeadingIconSize="20"
                FontSize="14"
                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                Text="{Binding SerialNumber}" />
            <StackPanel
                Grid.Row="5"
                Margin="0,10"
                HorizontalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    x:Name="Ok"
                    Margin="5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Xác nhận"
                    IsEnabled="{Binding IsEnable}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
                <Button
                    x:Name="Cancel"
                    Width="100"
                    Height="40"
                    Margin="5,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    IsEnabled="{Binding IsEnable}"
                    Style="{StaticResource MaterialDesignFlatButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Cancel" />
                        <TextBlock>Hủy</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</Window>
