<UserControl
    x:Class="Client.Views.InstrumentDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:Client.Domain"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <domain:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <domain:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>
        <materialDesign:Card
            Grid.Column="0"
            MinWidth="500"
            Margin="0,0,0,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Orientation="Vertical">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="25"
                                Height="25"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Devices" />
                            <TextBlock
                                Margin="10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="{Binding Instrument.Name}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!--  Close Button  -->
                            <Button
                                Width="auto"
                                Height="auto"
                                Margin="0,5"
                                Padding="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action CloseDetailView()]"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Close" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                        Text="Đóng" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="EditInstrument"
                                Width="auto"
                                Height="auto"
                                Margin="10,0"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action EditInstrument()]"
                                Style="{StaticResource MaterialDesignOutlinedDarkButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Pencil" />
                                    <TextBlock
                                        Margin="5,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                        Text="Chỉnh sửa" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="auto"
                                Height="auto"
                                Padding="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                cal:Message.Attach="[Event Click] = [Action DeleteInstrumentCommand()]"
                                Background="Red"
                                BorderBrush="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Kind="Delete" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </Grid>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Status  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="ListStatus" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Tình trạng: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Status.Status}" />
                        <!--  Circle Color indicator  -->
                        <Ellipse
                            Width="15"
                            Height="15"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Fill="{Binding Instrument.Status.Color}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Instrument Type  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Sort" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Loại thiết bị: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Model.ModelType.Type}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Instrument Manufacturer  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Factory" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Nhà sản xuất: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Model.Manufacturer.Name}" />
                        <!--  Model  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Devices" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Model: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Model.Name}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Serial Number  -->
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="5,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Hashtag" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Số Seri: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.SerialNumber}" />
                    </StackPanel>
                    <!--  Seperator  -->
                    <Separator Margin="0,5" />
                    <!--  INSTRUMENT DETAILS  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="CHI TIẾT" />
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Install Date  -->
                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Calendar" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Ngày lắp đặt: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.InstallDate, StringFormat={}{0:dd/MM/yyyy}}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Install Date  -->
                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Location" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Địa chỉ lắp đặt: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Location}" />
                    </StackPanel>
                    <DockPanel>
                        <StackPanel Margin="0,5" Orientation="Horizontal">
                            <!--  Last PM Date  -->
                            <materialDesign:PackIcon
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="20"
                                Height="20"
                                Margin="5,0"
                                HorizontalAlignment="Left"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Calendar" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="Lần bảo trì gần nhất: " />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignBody2TextBlock}"
                                Text="{Binding Instrument.LastPmDate, StringFormat={}{0:dd/MM/yyyy}}" />
                        </StackPanel>

                        <!--  Last PM Date  -->
                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="30,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Calendar" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Lần bảo trì tiếp theo: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.NextPmDate, StringFormat={}{0:dd/MM/yyyy}}" />

                    </DockPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Customer  -->
                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="Account" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Khách hàng: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Customer.Name}" />
                    </StackPanel>
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <!--  Customer Address  -->
                        <materialDesign:PackIcon
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                            Kind="AddressMarker" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="Medium"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="Địa chỉ: " />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignBody2TextBlock}"
                            Text="{Binding Instrument.Customer.Address}" />
                    </StackPanel>
                    <Separator Margin="0,5" />
                    <!--  Description tb  -->
                    <TextBlock
                        Margin="0,5"
                        FontWeight="Medium"
                        Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                        Text="MÔ TẢ" />
                    <TextBox
                        MaxHeight="300"
                        Margin="0,5"
                        HorizontalAlignment="Stretch"
                        materialDesign:TextFieldAssist.HasLeadingIcon="True"
                        materialDesign:TextFieldAssist.LeadingIcon="TextBox"
                        materialDesign:TextFieldAssist.LeadingIconSize="20"
                        FontSize="14"
                        IsReadOnly="True"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding Instrument.Description}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ScrollViewer>
        </materialDesign:Card>
        <GridSplitter
            Grid.Column="1"
            Width="5"
            HorizontalAlignment="Stretch" />
        <!--  Ticket Card  -->
        <materialDesign:Card
            Grid.Column="2"
            Margin="0,0,10,10"
            Padding="15"
            materialDesign:ElevationAssist.Elevation="Dp5"
            UniformCornerRadius="30">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">

                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  INSTRUMENT TITLE  -->
                    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="25"
                                Height="25"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                Kind="Ticket" />
                            <TextBlock
                                Margin="10"
                                VerticalAlignment="Center"
                                FontWeight="Medium"
                                Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                Text="THẺ LIÊN QUAN" />
                        </StackPanel>
                        <!--  Nút thêm mới  -->
                        <Button
                            x:Name="AddTicket"
                            Width="auto"
                            Height="auto"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            cal:Message.Attach="[Event Click] = [Action AddTicket()]"
                            Style="{StaticResource MaterialDesignFlatDarkButton}"
                            Visibility="{Binding IsNewButtonVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Kind="Plus" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                    Text="Thêm mới" />
                            </StackPanel>
                        </Button>
                    </DockPanel>

                    <!--  Seperator  -->
                    <Separator Grid.Row="1" Margin="0,0,0,5" />
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Tickets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <materialDesign:Card
                                        Padding="10"
                                        HorizontalAlignment="Stretch"
                                        materialDesign:ElevationAssist.Elevation="Dp5"
                                        BorderThickness="2"
                                        UniformCornerRadius="5">
                                        <StackPanel
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            Orientation="Vertical">
                                            <DockPanel Grid.Column="0" HorizontalAlignment="Stretch">
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Kind="Ticket" />
                                                <TextBlock
                                                    Margin="5,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="Số thẻ: " />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding TicketNumber}" />
                                                <TextBlock
                                                    Margin="5,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="-" />
                                                <TextBlock
                                                    Margin="5,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Center"
                                                    FontWeight="Medium"
                                                    Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                                <Button
                                                    Grid.Column="1"
                                                    Width="auto"
                                                    Height="auto"
                                                    Padding="5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    cal:Message.Attach="[Event Click] = [Action OpenTicketDetail($eventArgs)]"
                                                    Style="{StaticResource MaterialDesignFlatDarkButton}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="20"
                                                            Height="20"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Kind="Search" />
                                                    </StackPanel>
                                                </Button>
                                            </DockPanel>
                                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                    <RowDefinition Height="auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <!--  Status  -->
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="ListStatus" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="Trạng thái: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="{Binding Status.Status}" />
                                                    <!--  Circle Color indicator  -->
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="{Binding Status.Color}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <!--  Priority  -->
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="PriorityHigh" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="Mức độ ưu tiên: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="{Binding Priority.Name}" />
                                                    <!--  Circle Color indicator  -->
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="{Binding Priority.Color}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal">
                                                    <!--  Ticket Type  -->
                                                    <materialDesign:PackIcon
                                                        Width="20"
                                                        Height="20"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="Sort" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="Loại Ticket: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                        Text="{Binding Type.Type}" />
                                                    <!--  Circle Color indicator  -->
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        Margin="5,0"
                                                        VerticalAlignment="Center"
                                                        Fill="{Binding Type.Color}" />
                                                </StackPanel>
                                                <!--  Created Date  -->
                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        Margin="30,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="Calendar" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="Ngày tạo: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding DateCreated, StringFormat={}{0:dd/MM/yyyy}}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <!--  OverDue Date  -->
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        Margin="30,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="Calendar" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="Ngày đến hạn: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Foreground="{Binding Overdue, Converter={StaticResource BoolToColorConverter}}"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding DateDue, StringFormat={}{0:dd/MM/yyyy}}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Row="2"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                                    <!--  Updated Date  -->
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        Margin="30,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                                                        Kind="Calendar" />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontWeight="Medium"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="Ngày cập nhật: " />
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                        Text="{Binding DateUpdated, StringFormat={}{0:dd/MM/yyyy}}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </materialDesign:Card>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>
        </materialDesign:Card>



    </Grid>
</UserControl>
