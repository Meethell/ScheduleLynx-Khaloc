<UserControl
    x:Class="Client.Views.DataViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cal="http://www.caliburnproject.org"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Client.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="clr-namespace:Client.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{DynamicResource MaterialDesignFont}"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="15" />
                </Grid.RowDefinitions>
                <ComboBox
                    x:Name="cbEntity"
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="auto"
                    MinWidth="150"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding EntityNameList}"
                    SelectedItem="{Binding SelectedEntityName}" />
                <DockPanel
                    x:Name="panel"
                    Grid.Row="2"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    MaxHeight="500">
                    <ScrollViewer
                        MaxWidth="{Binding ActualWidth, ElementName=panel}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        IsEnabled="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid
                            x:Name="dgData"
                            CanUserAddRows="{Binding CanUserEdit}"
                            IsReadOnly="{Binding IsReadOnly}"
                            ItemsSource="{Binding DisplayedData}"
                            SelectionChanged="DgData_SelectionChanged"
                            SelectionMode="Extended" />
                    </ScrollViewer>
                </DockPanel>
                <Separator Grid.Row="3" Grid.Column="1" />
                <StackPanel
                    Grid.Row="4"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="bnEdit"
                            Width="73"
                            Margin="10"
                            VerticalAlignment="Top"
                            Content="Edit" />
                        <Button
                            x:Name="bnSave"
                            Width="73"
                            Margin="10"
                            VerticalAlignment="Top"
                            Content="Save"
                            IsEnabled="{Binding CanUserEdit}" />
                        <Button
                            x:Name="bnDelete"
                            Width="73"
                            Margin="10"
                            VerticalAlignment="Top"
                            Content="Delete"
                            IsEnabled="{Binding CanUserEdit}" />
                    </StackPanel>
                    <Separator />
                    <TextBlock
                        Margin="5"
                        FontSize="34"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="Database Maintenance" />
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="bnBackupDatabase"
                            Width="auto"
                            Margin="10"
                            VerticalAlignment="Top"
                            Content="Backup" />
                        <Button
                            x:Name="bnImportDatabase"
                            Width="auto"
                            Margin="10"
                            VerticalAlignment="Top"
                            Content="Import" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </ScrollViewer>

    </Grid>

</UserControl>
